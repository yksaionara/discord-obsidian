# Sourced before building a binary people download: `source scripts/release-env
# TARGET`, then plain `cargo build --target TARGET`. Rust embeds source paths for panic messages, and C's __FILE__ ends
# up in error messages too; they'd name the folders of the machine that built
# it, its owner's home folder among them. These flags name none.
# CARGO_ENCODED_RUSTFLAGS replaces .cargo/config.toml's rustflags, so a
# target's own come along here.
obsidian_release_target=${1:?usage: source scripts/release-env TARGET}
obsidian_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# Widest first: rustc and Clang take the last mapping that matches.
obsidian_maps=("$HOME=/home" "${CARGO_HOME:-$HOME/.cargo}=/cargo" "$obsidian_root=/obsidian")
obsidian_rust=()
obsidian_c=()
for map in "${obsidian_maps[@]}"; do
  obsidian_rust+=("--remap-path-prefix=$map")
  obsidian_c+=("-ffile-prefix-map=$map")
done
case "$obsidian_release_target" in
  x86_64-pc-windows-msvc)
    # Match LiveKit's Windows runtime linkage, as .cargo/config.toml does.
    obsidian_rust=(-Ctarget-feature=+crt-static "${obsidian_rust[@]}")
    # cargo-xwin compiles C with clang-cl, which takes Clang's flags this way.
    obsidian_c=("${obsidian_c[@]/#//clang:}") ;;
  x86_64-unknown-linux-gnu) ;;
  *) echo "scripts/release-env: no flags known for $obsidian_release_target" >&2; return 2 ;;
esac
CARGO_ENCODED_RUSTFLAGS=$(IFS=$'\x1f'; printf '%s' "${obsidian_rust[*]}")
export CARGO_ENCODED_RUSTFLAGS
# The cc crate reads only the first of CFLAGS_<target> and its fallbacks, and
# `cargo xwin build` sets that one, so take its environment, which adds to
# these rustflags, and add the C flags to what it sets.
obsidian_target_flags=${obsidian_release_target//-/_}
if [[ "$obsidian_release_target" == *-windows-msvc ]]; then
  eval "$(cargo xwin env --target "$obsidian_release_target")"
  # thorvg-sys tells bindgen's libclang `--target=x86_64-none-elf` on every
  # cross build, which can't read the MSVC headers. bindgen adds these
  # arguments after a build script's, and Clang takes the last target.
  obsidian_bindgen="BINDGEN_EXTRA_CLANG_ARGS_$obsidian_target_flags"
  export "$obsidian_bindgen=${!obsidian_bindgen:-} --target=$obsidian_release_target"
fi
obsidian_cflags="CFLAGS_$obsidian_target_flags" obsidian_cxxflags="CXXFLAGS_$obsidian_target_flags"
export "$obsidian_cflags=${!obsidian_cflags:-} ${obsidian_c[*]}"
export "$obsidian_cxxflags=${!obsidian_cxxflags:-} ${obsidian_c[*]}"
unset obsidian_release_target obsidian_root obsidian_maps obsidian_rust obsidian_c map \
  obsidian_target_flags obsidian_cflags obsidian_cxxflags obsidian_bindgen
