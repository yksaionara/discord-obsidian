import { ScrollView, ListView } from "scrollview.slint";
import { Theme, Middle, Label, Tip, Popup } from "theme.slint";
import { ActionButton, IconButton, Avatar, CallButton, VolumeSlider, MenuItem, TextField } from "controls.slint";
import { EmojiCell, EmojiFace } from "messages.slint";

export struct PersonRow {
    id: string, name: string, status: string, muted: bool, deafened: bool, speaking: bool, connected: bool, initial: string, tint: color, picture: image,
    /// Sharing their screen.
    live: bool,
    /// Their camera is on.
    video: bool,
    /// This account, in a call.
    local: bool,
    /// This account, in the call on another client: dimmed, without icons.
    elsewhere: bool,
    /// Muted or deafened by the Discord server, whose icons show in red.
    server-muted: bool,
    server-deafened: bool,
    /// Who they are across calls, by Discord or Matrix user id, which their
    /// volumes are remembered by.
    person: string,
}

/// A stream being watched: whose, its newest picture, what shows until it,
/// and whether its sound is muted here.
export struct WatchedStream { user: string, person: string, frame: image, status: string, muted: bool }

// Marks someone sharing their screen, as Discord's red LIVE tag does.
// Clickable when it opens the stream.
export component LivePill inherits Rectangle {
    in property <bool> clickable;
    in property <string> label: "Watch stream";
    callback clicked;
    width: live-text.preferred-width + 10px; height: 16px; border-radius: 8px;
    background: root.clickable && live-touch.has-hover ? Theme.danger-hover : Theme.danger;
    accessible-role: button; accessible-enabled: root.clickable; accessible-label: root.clickable ? root.label : "Live";
    accessible-action-default => { if root.clickable { root.clicked(); } }
    live-text := Text { text: "LIVE"; color: Theme.on-danger; font-size: 10px; font-weight: 800; letter-spacing: 0.4px; }
    live-touch := TouchArea {
        enabled: root.clickable; mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// Who watches a stream, over its top right as Discord shows them: an eye and
// how many, then the first three's avatars overlapping and how many more.
// Hovering names them all.
export component ViewerStack inherits Rectangle {
    in property <[PersonRow]> viewers;
    /// "Watching: " and their names, for the tooltip.
    in property <string> names;
    property <int> faces: min(3, root.viewers.length);
    property <length> pictures: root.faces > 0 ? 22px + (root.faces - 1) * 15px : 0px;
    visible: root.viewers.length > 0;
    width: 8px + 16px + 4px + count.preferred-width + 6px + root.pictures + (root.viewers.length > 3 ? 4px + more.preferred-width : 0px) + 6px;
    height: 30px; border-radius: 15px; background: #000000a6;
    accessible-role: text; accessible-label: root.names;
    Image { x: 8px; width: 16px; height: 16px; source: @image-url("icons/eye.svg"); colorize: #ffffff; }
    count := Text {
        x: 28px; text: root.viewers.length; color: #ffffff; font-size: 13px; font-weight: 700;
    }
    for viewer[index] in root.viewers: Rectangle {
        visible: index < 3;
        x: 28px + count.preferred-width + 6px + index * 15px;
        width: 26px; height: 26px; border-radius: 13px; background: #000000;
        Avatar { size: 22px; initial: viewer.initial; tint: viewer.tint; picture: viewer.picture; }
    }
    more := Text {
        visible: root.viewers.length > 3;
        x: 28px + count.preferred-width + 6px + root.pictures + 4px;
        text: "+" + (root.viewers.length - 3); color: #ffffff; font-size: 13px; font-weight: 700;
    }
    TouchArea {
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.names; Tip.side = 2;
                Tip.x = root.absolute-position.x + root.width / 2; Tip.y = root.absolute-position.y + root.height;
            } else if Tip.text == root.names {
                Tip.text = "";
            }
        }
    }
}

// How the call's connection is doing, for the signal icon's tooltip and the
// popout it opens, as Discord's voice panel shows them. Rust fills in the
// numbers only when `read` asks, while one of them shows.
export global CallLink {
    /// The call measures its connection, as a Discord call does.
    in property <bool> measured;
    /// 0 while unknown, then 1 fine, 2 average and 3 bad, as Discord grades it.
    in property <int> quality;
    /// Media leaves end-to-end encrypted.
    in property <bool> end-to-end;
    /// The last ping and the average, as "42 ms"; empty until one comes.
    in property <string> ping;
    in property <string> average;
    /// The share of this account's packets lost, as "1.2%"; empty until known.
    in property <string> loss;
    /// The last five minutes of pings as path commands in a 300 by 100 box,
    /// and the ping at its top, in milliseconds.
    in property <string> graph;
    in property <int> graph-top;
    /// The voice privacy code in groups of five digits, while the call is
    /// end-to-end encrypted with someone else in it.
    in property <[string]> code;
    /// While this account's screen is live, how it goes out: the encoder
    /// ("NVENC on the GPU"), the codec, the size and frame rate, the
    /// bitrate sent and aimed for ("3.8 Mbit/s"), and what viewers asked
    /// of it.
    in property <bool> streaming;
    in property <string> encoder;
    in property <string> codec;
    in property <string> picture;
    in property <string> sent;
    in property <string> target;
    in property <string> keyframes;
    in property <string> resent;
    callback read();
}

// The signal strength Discord's voice panel shows: bars and a colour by how
// good the connection is, grey while it's unknown.
export component SignalIcon inherits Image {
    in property <int> quality;
    source: root.quality == 3 ? @image-url("icons/signal-low.svg")
        : root.quality == 2 ? @image-url("icons/signal-medium.svg") : @image-url("icons/signal-high.svg");
    colorize: root.quality == 1 ? Theme.live : root.quality == 2 ? Theme.accent
        : root.quality == 3 ? Theme.danger : Theme.muted;
    image-fit: contain;
}

// Over the call's status or its signal icon: the ping as a tooltip, and a
// click opens the details, at this point in the window.
export component LinkTouch inherits TouchArea {
    in property <int> tip-side: 0;
    callback open(length, length, length, length);
    enabled: CallLink.measured;
    mouse-cursor: CallLink.measured ? MouseCursor.pointer : MouseCursor.default;
    changed has-hover => {
        if self.has-hover {
            CallLink.read();
            if CallLink.ping != "" {
                Tip.text = CallLink.ping; Tip.side = root.tip-side;
                Tip.x = self.absolute-position.x + self.width / 2;
                Tip.y = root.tip-side == 2 ? self.absolute-position.y + self.height : self.absolute-position.y;
            }
        } else if Tip.text == CallLink.ping {
            Tip.text = "";
        }
    }
    clicked => {
        Tip.text = "";
        root.open(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
    }
}

component LinkTab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 28px; width: tab-text.preferred-width;
    accessible-role: tab; accessible-label: root.text; accessible-item-selected: root.on;
    accessible-action-default => { root.clicked(); }
    tab-text := Text {
        y: 0; text: root.text; font-size: 14px; font-weight: 700;
        color: root.on || tab-touch.has-hover ? Theme.text : Theme.muted;
    }
    Rectangle { y: parent.height - 2px; height: 2px; background: root.on ? Theme.accent : transparent; }
    tab-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

// A label and its value in bold, as the popout's rows are.
component LinkRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 4px; alignment: start;
    Text { text: root.label; color: Theme.secondary; font-size: 14px; }
    Text { text: root.value; color: Theme.text; font-size: 14px; font-weight: 700; }
}

// The call's connection in detail, as Discord's popout from its voice panel:
// a graph of the ping over the last five minutes, the average and last ping,
// the packets lost, and while end-to-end encrypted, the voice privacy code to
// compare with the others in the call. While this account's screen is live,
// a Stream tab says how it goes out.
export component CallLinkCard inherits Rectangle {
    out property <length> content-height: link-content.preferred-height;
    callback copy(string);
    // The tab picked: 0 Connection, 1 Privacy, 2 Stream; Connection shows
    // while the one picked isn't there.
    property <int> tab;
    property <int> shown: root.tab == 1 && CallLink.code.length > 0 ? 1
        : root.tab == 2 && CallLink.streaming ? 2 : 0;
    property <bool> copied;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox; accessible-label: "Voice details";
    init => { CallLink.read(); }
    Timer { interval: 1s; running: true; triggered => { CallLink.read(); } }
    Timer { interval: 2s; running: root.copied; triggered => { root.copied = false; } }
    link-content := VerticalLayout {
        padding: 16px; spacing: 10px;
        if CallLink.code.length > 0 || CallLink.streaming: HorizontalLayout {
            spacing: 16px; alignment: start;
            LinkTab { text: "Connection"; on: root.shown == 0; clicked => { root.tab = 0; } }
            if CallLink.code.length > 0: LinkTab { text: "Privacy"; on: root.shown == 1; clicked => { root.tab = 1; } }
            if CallLink.streaming: LinkTab { text: "Stream"; on: root.shown == 2; clicked => { root.tab = 2; } }
        }
        if root.shown == 0: VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 80px; border-radius: 6px; background: Theme.sunken; clip: true;
                accessible-role: image;
                accessible-label: "Ping over the last five minutes, up to " + CallLink.graph-top + " ms";
                Rectangle { y: 0px; height: 1px; background: Theme.line; }
                Rectangle { y: parent.height / 2; height: 1px; background: Theme.line; }
                Path {
                    width: parent.width; height: parent.height;
                    viewbox-width: 300; viewbox-height: 100;
                    commands: CallLink.graph;
                    stroke: Theme.link; stroke-width: 2px;
                }
                Text { x: 6px; y: 4px; text: CallLink.graph-top + " ms"; color: Theme.muted; font-size: 11px; }
                Text { x: 6px; y: parent.height / 2 + 4px; text: CallLink.graph-top / 2 + " ms"; color: Theme.muted; font-size: 11px; }
            }
            LinkRow { label: "Average ping:"; value: CallLink.average != "" ? CallLink.average : "Unknown"; }
            if CallLink.ping != "": LinkRow { label: "Last ping:"; value: CallLink.ping; }
            if CallLink.loss != "": LinkRow { label: "Outbound packet loss rate:"; value: CallLink.loss; }
            Text {
                text: "You may notice delayed audio at 250 ms or higher. If the problem persists, disconnect and try again."
                    + (CallLink.loss != "" ? " You may sound robotic if your packet loss rate is over 10%." : "");
                color: Theme.muted; font-size: 13px; wrap: word-wrap;
            }
        }
        if root.shown == 2: VerticalLayout {
            spacing: 8px;
            LinkRow { label: "Encoder:"; value: CallLink.encoder; }
            LinkRow { label: "Codec:"; value: CallLink.codec; }
            LinkRow { label: "Resolution:"; value: CallLink.picture; }
            LinkRow { label: "Sending:"; value: CallLink.sent; }
            LinkRow { label: "Aiming for:"; value: CallLink.target; }
            LinkRow { label: "Keyframes viewers asked for:"; value: CallLink.keyframes; }
            LinkRow { label: "Packets resent:"; value: CallLink.resent; }
            Text {
                text: "The bitrate starts low and climbs toward the most your quality allows while your connection keeps up, backing off when packets are lost. Fast motion at a low bitrate looks blocky to viewers.";
                color: Theme.muted; font-size: 13px; wrap: word-wrap;
            }
        }
        if root.shown == 1: VerticalLayout {
            spacing: 10px;
            Text { text: "Voice Privacy Code"; color: Theme.text; font-size: 15px; font-weight: 700; }
            Text {
                text: "A new code is generated when people join or leave this call. Compare it with the others in the call: everyone sees the same numbers.";
                color: Theme.secondary; font-size: 13px; wrap: word-wrap;
            }
            Rectangle {
                height: code-rows.preferred-height; border-radius: 6px; background: Theme.sunken;
                code-rows := VerticalLayout {
                    padding: 10px; spacing: 6px;
                    for row in [0, 1]: HorizontalLayout {
                        for column in [0, 1, 2]: Text {
                            horizontal-stretch: 1; horizontal-alignment: center;
                            text: CallLink.code[row * 3 + column]; color: Theme.text;
                            font-size: 18px; font-weight: 700;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                ActionButton {
                    text: root.copied ? "Copied" : "Copy"; small: true;
                    icon: @image-url("icons/copy.svg");
                    clicked => {
                        root.copy(CallLink.code[0] + " " + CallLink.code[1] + " " + CallLink.code[2] + " "
                            + CallLink.code[3] + " " + CallLink.code[4] + " " + CallLink.code[5]);
                        root.copied = true;
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Text {
                text: "Only you and the others in this call can hear you. Nobody else, not even Discord, can listen in.";
                color: Theme.secondary; font-size: 13px; wrap: word-wrap;
            }
        }
        Rectangle {
            height: notice.preferred-height; border-radius: 6px; background: Theme.live.with-alpha(0.12);
            notice := HorizontalLayout {
                padding: 8px; spacing: 8px;
                Image { source: @image-url("icons/lock.svg"); width: 16px; colorize: Theme.live; image-fit: contain; }
                Text {
                    text: CallLink.end-to-end ? "End-to-end encrypted" : "Secure connection";
                    color: Theme.live; font-size: 13px; font-weight: 700; vertical-alignment: center;
                }
            }
        }
    }
}

// One of the voice panel's wide buttons under the status, as Discord's panel
// has for the camera and the screen: lit while what it starts is on.
component DockButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> on;
    /// Red, for ending something, as Discord's Stop Streaming.
    in property <bool> danger;
    callback clicked;
    height: 32px; border-radius: 8px;
    background: root.danger ? (touch.has-hover && root.enabled ? Theme.danger-hover : Theme.danger)
        : root.on ? (touch.has-hover ? Theme.live.with-alpha(0.32) : Theme.live.with-alpha(0.22))
        : touch.has-hover && root.enabled ? Theme.hover : Theme.raised;
    animate background { duration: Theme.quick; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        source: root.icon; width: 20px; height: 20px;
        colorize: !root.enabled ? Theme.faint : root.danger ? #ffffff : root.on || touch.has-hover ? Theme.text : Theme.secondary;
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
        clicked => { Tip.text = ""; root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.label; Tip.side = 0;
                Tip.x = root.absolute-position.x + root.width / 2; Tip.y = root.absolute-position.y;
            } else if Tip.text == root.label {
                Tip.text = "";
            }
        }
    }
}

// What the voice connection is doing, above the account panel, with a way to
// leave the call or to dismiss what went wrong; during a call, the soundboard,
// the camera and sharing the screen, and while sharing, that it's live,
// wherever the window is.
export component VoiceDock inherits Rectangle {
    /// The top of Discord's floating card, which the account panel ends:
    /// no ground of its own, and its icons on the avatar's axis.
    in property <bool> card;
    // The column the icons sit in, and where in it a 24px icon starts.
    property <length> lead: root.card ? 60px : 64px;
    property <length> mark: root.card ? 16px : 24px;
    in property <string> voice-status;
    /// How long the call has lasted, as 12:05.
    in property <string> voice-time;
    in property <string> voice-detail;
    in property <string> voice-name;
    in property <color> voice-color;
    in property <bool> voice-active;
    in property <bool> voice-ready;
    in property <bool> voice-leaving;
    in property <string> voice-warning;
    in property <string> voice-error;
    in property <bool> can-share;
    in property <bool> sharing;
    in property <bool> share-live;
    in property <string> share-status;
    /// Who watches this account's stream, in the call's order, and
    /// "Watching: " and their names.
    in property <[PersonRow]> share-viewers;
    in property <string> share-viewer-names;
    property <int> share-watchers: root.share-viewers.length;
    /// The Who's Watching add-on: a Spectators row under "Your screen".
    in property <bool> whos-watching;
    in property <bool> can-film;
    in property <bool> camera-on;
    /// The camera is on its way, until its first picture.
    in property <bool> camera-starting;
    /// The call has Discord's soundboard.
    in property <bool> can-soundboard;
    callback leave-voice;
    callback dismiss-voice-error;
    callback toggle-camera;
    callback toggle-share;
    /// Sharing starts from a menu, opened at this point in the window, and
    /// while sharing, the same menu switches what's shared.
    callback open-share-menu(length, length);
    /// The soundboard, opened above this point in the window.
    callback open-soundboard(length, length);
    /// The call's connection in detail, from where its status is.
    callback open-call-link(length, length, length, length);
    /// A spectator's profile, beside their avatar at this point in the window.
    callback open-viewer-profile(PersonRow, length, length, length, length);
    background: root.card ? transparent : Theme.panel;
    VerticalLayout {
        padding-top: 10px; padding-bottom: root.card ? 10px : 8px; padding-right: root.card ? 10px : 8px; spacing: 6px;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: root.lead;
                if !CallLink.measured || !root.voice-ready: Image {
                    x: root.mark; width: 24px; height: 24px; source: @image-url("icons/volume-2.svg");
                    image-fit: contain; colorize: root.voice-color;
                }
                if CallLink.measured && root.voice-ready: SignalIcon {
                    x: root.mark; width: 24px; height: 24px; quality: CallLink.quality;
                }
                LinkTouch { open(x, y, width, height) => { root.open-call-link(x, y, width, height); } }
            }
            Rectangle {
                horizontal-stretch: 1;
                min-height: status-text.min-height; preferred-height: status-text.preferred-height;
                status-text := VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.voice-status; color: root.voice-color; font-size: 15px; font-weight: 700; overflow: elide; }
                        if root.voice-time != "": Text {
                            text: root.voice-time; color: Theme.muted; font-size: 13px; vertical-alignment: center;
                            accessible-label: "Call time " + root.voice-time;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.voice-active: Text { text: root.voice-detail; color: Theme.muted; font-size: 13px; overflow: elide; }
                }
                LinkTouch { open(x, y, width, height) => { root.open-call-link(x, y, width, height); } }
            }
            if root.voice-active: IconButton {
                icon: @image-url("icons/phone-off.svg"); label: "Leave voice"; danger: true;
                enabled: !root.voice-leaving;
                clicked => { root.leave-voice(); }
            }
        }
        if root.voice-active && root.sharing: HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: root.lead;
                if root.share-live: LivePill { x: root.mark + 12px - self.width / 2; }
                if !root.share-live: Image {
                    x: root.mark + 2px; width: 20px; height: 20px; source: @image-url("icons/screen-share.svg");
                    image-fit: contain; colorize: Theme.accent;
                }
                // Who's Watching: hovering the LIVE tag names the spectators.
                if root.whos-watching && root.share-live: TouchArea {
                    property <string> tip: root.share-watchers > 0 ? root.share-viewer-names : "No spectators";
                    changed has-hover => {
                        if self.has-hover {
                            Tip.text = self.tip; Tip.side = 0;
                            Tip.x = self.absolute-position.x + root.mark + 12px; Tip.y = self.absolute-position.y;
                        } else if Tip.text == self.tip {
                            Tip.text = "";
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text { text: "Your screen"; color: Theme.text; font-size: 14px; font-weight: 700; overflow: elide; }
                Text {
                    text: !root.share-live ? root.share-status
                        : root.share-watchers > 0 ? "Streaming to " + root.voice-name + " · " + root.share-watchers + " watching"
                        : "Streaming to " + root.voice-name;
                    color: Theme.muted; font-size: 13px; overflow: elide;
                }
            }
            IconButton {
                icon: @image-url("icons/screen-share-off.svg"); label: "Stop sharing"; danger: true;
                clicked => { root.toggle-share(); }
            }
        }
        // Who's Watching, as Equicord's plugin shows it: a heading with how
        // many, then their avatars overlapping, as many as fit up to 12 and
        // how many more. An avatar opens its profile; hovering names it, and
        // hovering the count names everyone.
        if root.voice-active && root.share-live && root.whos-watching: VerticalLayout {
            padding-left: 8px; spacing: 6px; alignment: start; vertical-stretch: 0;
            Text {
                text: "SPECTATORS — " + root.share-watchers;
                color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
            }
            if root.share-watchers == 0: Text { text: "No spectators"; color: Theme.secondary; font-size: 13px; }
            if root.share-watchers > 0: faces-row := Rectangle {
                property <int> fit: max(1, min(12, floor((self.width - 36px) / 20px)));
                property <int> faces: root.share-watchers > self.fit ? self.fit - 1 : root.share-watchers;
                // Fixed, or the dock takes the sidebar's spare height.
                min-height: 28px; max-height: 28px; vertical-stretch: 0;
                accessible-role: text; accessible-label: root.share-viewer-names;
                for viewer[index] in root.share-viewers: Rectangle {
                    visible: index < faces-row.faces;
                    x: index * 20px; width: 28px; height: 28px; border-radius: 14px;
                    background: Theme.panel;
                    Avatar { size: 24px; initial: viewer.initial; tint: viewer.tint; picture: viewer.picture; }
                    TouchArea {
                        enabled: parent.visible; mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.open-viewer-profile(viewer, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                        }
                        changed has-hover => {
                            if self.has-hover {
                                Tip.text = viewer.name; Tip.side = 0;
                                Tip.x = self.absolute-position.x + self.width / 2; Tip.y = self.absolute-position.y;
                            } else if Tip.text == viewer.name {
                                Tip.text = "";
                            }
                        }
                    }
                    accessible-role: button; accessible-label: viewer.name;
                    accessible-action-default => {
                        root.open-viewer-profile(viewer, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                    }
                }
                if root.share-watchers > faces-row.faces: Rectangle {
                    x: faces-row.faces * 20px; width: max(28px, more-text.preferred-width + 12px); height: 28px; border-radius: 14px;
                    background: Theme.panel;
                    Rectangle {
                        width: parent.width - 4px; height: 24px; border-radius: 12px;
                        background: more-touch.has-hover ? Theme.hover : Theme.sidebar;
                        more-text := Text {
                            text: "+" + (root.share-watchers - faces-row.faces);
                            color: Theme.text; font-size: 12px; font-weight: 700;
                        }
                    }
                    more-touch := TouchArea {
                        changed has-hover => {
                            if self.has-hover {
                                Tip.text = root.share-viewer-names; Tip.side = 0;
                                Tip.x = self.absolute-position.x + self.width / 2; Tip.y = self.absolute-position.y;
                            } else if Tip.text == root.share-viewer-names {
                                Tip.text = "";
                            }
                        }
                    }
                }
            }
        }
        if root.voice-active && (root.can-film || root.can-share || root.sharing || root.can-soundboard): HorizontalLayout {
            padding-left: 8px; spacing: 8px;
            if root.can-soundboard: DockButton {
                horizontal-stretch: 1; enabled: root.voice-ready;
                icon: @image-url("icons/soundboard.svg"); label: "Open Soundboard";
                clicked => { root.open-soundboard(self.absolute-position.x, self.absolute-position.y); }
            }
            if root.can-film: DockButton {
                horizontal-stretch: 1; enabled: root.voice-ready; on: root.camera-on;
                icon: root.camera-on ? @image-url("icons/video.svg") : @image-url("icons/video-off.svg");
                label: root.camera-starting ? "Starting camera..." : root.camera-on ? "Turn off camera" : "Turn on camera";
                opacity: root.camera-starting ? (0.6 + 0.4 * sin(animation-tick() / 1ms * 0.36deg)) : 1;
                clicked => { root.toggle-camera(); }
            }
            // As Discord's: green while streaming, when it opens the menu to
            // stop, change or tune the stream; otherwise the share dialog.
            if root.can-share || root.sharing: DockButton {
                horizontal-stretch: 1; enabled: root.voice-ready; on: root.sharing;
                icon: @image-url("icons/screen-share.svg");
                label: root.sharing ? "Stream options" : "Share your screen";
                clicked => { root.open-share-menu(self.absolute-position.x, self.absolute-position.y); }
            }
        }
        // Wrapped in the dock's width; a scroll view would neither wrap nor stay short.
        if root.voice-warning != "" && root.voice-error == "": HorizontalLayout {
            padding-left: root.lead;
            Label { text: root.voice-warning; color: Theme.accent; }
        }
        if root.voice-error != "": HorizontalLayout {
            padding-left: root.lead;
            Text { text: root.voice-error; color: Theme.text; font-size: 14px; wrap: word-wrap; }
        }
        if !root.voice-active: HorizontalLayout {
            padding-left: root.lead - 10px;
            ActionButton { text: "Dismiss"; ghost: true; small: true; clicked => { root.dismiss-voice-error(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// The game this account plays, between the call and the account panel in
// Discord's floating card, as Discord's client shows it, with a button
// that streams it once in a call.
export component GameBar inherits Rectangle {
    in property <string> game;
    /// A line above it, under the call.
    in property <bool> divided;
    in property <bool> can-stream;
    callback stream(length, length);
    height: 44px;
    accessible-role: groupbox; accessible-label: "Playing " + root.game;
    if root.divided: Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: Theme.line; }
    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 10px;
        Rectangle {
            width: 24px;
            Image { width: 22px; height: 22px; source: @image-url("icons/gamepad.svg"); colorize: Theme.live; }
        }
        Text {
            text: root.game; color: Theme.text; font-size: 14px; font-weight: 700;
            overflow: elide; vertical-alignment: center; horizontal-stretch: 1;
        }
        IconButton {
            icon: @image-url("icons/screen-share.svg");
            label: root.can-stream ? "Stream " + root.game : "Join a voice channel to stream " + root.game;
            enabled: root.can-stream; radius: 4px;
            clicked => { root.stream(self.absolute-position.x, self.absolute-position.y); }
        }
    }
}

// A DM's call this account isn't in: who is, and a way to join it, or to
// answer it when it rings.
export component CallInvite inherits VerticalLayout {
    in property <[PersonRow]> call-people;
    in property <string> call-note;
    in property <bool> call-incoming;
    in property <string> call-room;
    in property <bool> can-join;
    callback answer-call(string, bool);
    padding: 20px; spacing: 12px; alignment: center;
    HorizontalLayout {
        alignment: center; spacing: 8px;
        for person in root.call-people: Avatar {
            size: 56px; initial: person.initial; tint: person.tint; picture: person.picture;
            accessible-role: image; accessible-label: person.name;
        }
    }
    Text { text: root.call-note; color: Theme.secondary; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
    HorizontalLayout {
        alignment: center; spacing: 16px;
        if root.call-incoming: CallButton {
            icon: @image-url("icons/phone-off.svg"); label: "Decline"; fill: Theme.danger;
            clicked => { root.answer-call(root.call-room, false); }
        }
        CallButton {
            icon: @image-url("icons/phone.svg"); label: root.call-incoming ? "Accept" : "Join the call";
            fill: Theme.live; enabled: root.can-join;
            clicked => { root.answer-call(root.call-room, true); }
        }
    }
}

// A voice channel this account isn't in: what it is, and a way to join.
export component JoinVoice inherits VerticalLayout {
    in property <string> room-name;
    in property <string> voice-description;
    in property <bool> preview;
    in property <bool> call-encrypted;
    in property <bool> voice-active;
    in property <bool> can-join;
    callback join-voice;
    padding: 32px; spacing: 14px; alignment: center;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
            Image { source: @image-url("icons/volume-2.svg"); width: 38px; height: 38px; colorize: Theme.secondary; }
        }
    }
    Text { text: root.room-name; color: Theme.text; font-size: 26px; font-weight: 900; horizontal-alignment: center; overflow: elide; }
    Text { text: root.voice-description; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
    if !root.preview && !root.call-encrypted: Text { text: "This channel is unencrypted. Discord only joins encrypted voice channels."; color: Theme.accent; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
    HorizontalLayout {
        alignment: center; padding-top: 6px;
        ActionButton { min-height: 42px; text: root.voice-active ? "Switch voice channel" : "Join voice"; primary: true; enabled: root.can-join; clicked => { root.join-voice(); } }
    }
}

// A stream or a camera kept in a corner of the window while its call isn't
// on screen, as Discord's picture in picture is. A click returns to the call;
// a drag moves it, and `dropped` asks the window for the nearest corner.
export component StreamPip inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <image> frame;
    in property <bool> live;
    in property <image> stop-icon;
    /// Stops what it shows; a camera has nothing to stop.
    in property <string> stop-label;
    in property <[PersonRow]> viewers;
    in property <string> viewer-names;
    /// How far the pointer has dragged it from its corner.
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    out property <bool> dragging;
    callback open-call;
    callback stop;
    callback dropped;
    width: 320px; height: 180px; border-radius: 8px; clip: true;
    background: #000000;
    border-width: 1px; border-color: Theme.edge;
    accessible-role: button; accessible-label: root.title + ". Return to the call";
    accessible-action-default => { root.open-call(); }
    Image { width: parent.width; height: parent.height; source: root.frame; image-fit: contain; }
    // The stage is black in every theme, so its note is a fixed grey.
    if root.frame.width == 0: Text {
        x: 16px; width: parent.width - 32px; height: parent.height;
        text: root.status; color: #b5b8c1; font-size: 14px;
        horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
    }
    if root.live: LivePill { x: 8px; y: 8px; }
    touch := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        moved => {
            if !self.pressed { return; }
            if !root.dragging && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.dragging = true;
            }
            if root.dragging {
                root.drag-x += self.mouse-x - self.pressed-x;
                root.drag-y += self.mouse-y - self.pressed-y;
            }
        }
        pointer-event(event) => {
            if event.kind != PointerEventKind.up || event.button != PointerEventButton.left { return; }
            if root.dragging {
                root.dragging = false;
                root.dropped();
            } else {
                root.open-call();
            }
        }
        // Inside the touch area, so the pointer on the stop button still hovers it.
        if self.has-hover && !root.dragging: Rectangle {
            background: @linear-gradient(180deg, #00000000 55%, #000000b0 100%);
            Text {
                x: 12px; y: parent.height - 34px; width: parent.width - 60px; height: 24px;
                text: root.title; color: #ffffff; font-size: 14px; font-weight: 700;
                vertical-alignment: center; overflow: elide;
            }
            if root.stop-label != "": IconButton {
                x: parent.width - self.width - 8px; y: parent.height - self.size - 8px; height: self.size;
                icon: root.stop-icon; label: root.stop-label; tint: #ffffff;
                fill: #000000a6; radius: 16px;
                clicked => { root.stop(); }
            }
        }
        ViewerStack {
            x: parent.width - self.width - 8px; y: 8px;
            viewers: root.viewers; names: root.viewer-names;
        }
    }
}

// A tile on the call's stage: what it shows comes in as children. A click
// shows it large; the large one goes full screen from a button or a double
// click, and a stream it shows stops from its top right.
component StageTile inherits Rectangle {
    in property <bool> focused;
    in property <bool> full;
    in property <string> label;
    /// Who watches the stream it shows.
    in property <[PersonRow]> viewers;
    in property <string> viewer-names;
    /// Stops the stream it shows; none when empty.
    in property <string> stop-label;
    /// Someone's stream not watched yet: Watch, and, while others are
    /// watched, watching it as well, as Discord's tiles offer.
    in property <bool> offer-watch;
    in property <bool> offer-also;
    /// A watched stream: LIVE at its top, and its sound's mute at its foot.
    in property <bool> live-badge;
    in property <bool> stream-controls;
    in property <bool> stream-muted;
    callback watch;
    callback watch-also;
    callback mute(bool);
    callback clicked;
    /// A click on it while it's the large one, as Discord's: the grid again.
    /// It waits out a double-click, which is full screen instead.
    callback unfocus;
    callback right-clicked(length, length);
    callback stop;
    callback full-screen(bool);
    property <bool> unfocusing;
    Timer {
        interval: 300ms; running: root.unfocusing;
        triggered => { root.unfocusing = false; root.unfocus(); }
    }
    /// A stream shows here: large, the wheel zooms it toward the pointer,
    /// up to 8x, and a drag moves it. As in Discord's client, the wheel
    /// eases there: each notch zooms 15%, gliding over a quarter second,
    /// and notches in a row carry on from where the last one is going; a
    /// drag follows the pointer at once.
    in property <bool> zoomable;
    property <float> zoom-to: 1;
    property <length> pan-x-to: 0px;
    property <length> pan-y-to: 0px;
    property <bool> gliding: true;
    out property <float> zoom: root.zoom-to;
    out property <length> pan-x: root.pan-x-to;
    out property <length> pan-y: root.pan-y-to;
    animate zoom, pan-x, pan-y { duration: root.gliding && !Theme.reduce-motion ? 250ms : 0ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
    property <length> grab-x;
    property <length> grab-y;
    function reset-zoom() { root.gliding = true; root.zoom-to = 1; root.pan-x-to = 0px; root.pan-y-to = 0px; }
    changed focused => { root.reset-zoom(); }
    changed zoomable => { root.reset-zoom(); }
    changed width => { root.reset-zoom(); }
    // Keeps the zoomed picture covering the tile.
    pure function clamp-pan(pan: length, size: length, zoom: float) -> length {
        return max(size - size * zoom, min(0px, pan));
    }
    // Zooms to `zoom`, keeping the point at x, y where it is. The pan
    // follows the zoom in step, so the point stays put as both glide.
    function zoom-at(x: length, y: length, zoom: float) {
        root.gliding = true;
        root.pan-x-to = root.clamp-pan(x - (x - root.pan-x-to) / root.zoom-to * zoom, root.width, zoom);
        root.pan-y-to = root.clamp-pan(y - (y - root.pan-y-to) / root.zoom-to * zoom, root.height, zoom);
        root.zoom-to = zoom;
    }
    border-radius: root.full ? 0px : 12px; clip: true;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    animate x, y, width, height { duration: root.full ? 0ms : 160ms; easing: ease-out; }
    property <bool> stop-shown: root.stop-label != "" && (touch.has-hover || root.focused);
    @children
    touch := TouchArea {
        mouse-cursor: root.zoom-to > 1 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab)
            : root.focused ? MouseCursor.default : MouseCursor.pointer;
        clicked => {
            if root.focused && !root.full && root.zoom-to <= 1 { root.unfocusing = true; } else { root.clicked(); }
        }
        double-clicked => { root.unfocusing = false; if root.focused { root.full-screen(!root.full); } }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.grab-x = root.pan-x-to; root.grab-y = root.pan-y-to;
            }
            // The middle button puts the picture back as it was.
            if event.button == PointerEventButton.middle && event.kind == PointerEventKind.down && root.zoom-to > 1 {
                root.reset-zoom();
            }
        }
        moved => {
            if root.zoom-to > 1 && self.pressed {
                root.gliding = false;
                root.pan-x-to = root.clamp-pan(root.grab-x + self.mouse-x - self.pressed-x, root.width, root.zoom-to);
                root.pan-y-to = root.clamp-pan(root.grab-y + self.mouse-y - self.pressed-y, root.height, root.zoom-to);
            }
        }
        scroll-event(event) => {
            // A small tile leaves the wheel to the grid, which scrolls.
            if !root.zoomable || !root.focused || event.delta-y == 0 || (root.zoom-to <= 1 && event.delta-y < 0) {
                return reject;
            }
            // A wheel's notch comes as 60 px; a touchpad's smaller steps
            // zoom as much less.
            root.zoom-at(self.mouse-x, self.mouse-y,
                max(1, min(8, root.zoom-to * Math.pow(1.15, max(-2, min(2, event.delta-y / 60px))))));
            return accept;
        }
        if root.zoom-to > 1: Rectangle {
            x: 10px; y: 10px; width: zoom-text.preferred-width + 20px; height: 28px;
            border-radius: 14px; background: zoom-touch.has-hover ? #000000d9 : #000000a6;
            accessible-role: button; accessible-label: "Reset zoom";
            zoom-text := Text {
                text: (round(root.zoom-to * 10) / 10) + "x  ·  Reset";
                color: #ffffff; font-size: 13px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
            zoom-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.reset-zoom(); }
            }
        }
        // Inside the touch area, so the pointer on a button still hovers the tile.
        if root.offer-watch: HorizontalLayout {
            alignment: center; spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 36px; width: watch-text.preferred-width + 32px; border-radius: 8px;
                    background: watch-touch.has-hover ? #6d6f78e6 : #4e5058cc;
                    border-width: 1px; border-color: #ffffff1f;
                    animate background { duration: Theme.quick; }
                    accessible-role: button; accessible-label: watch-text.text;
                    accessible-action-default => { root.watch(); }
                    watch-text := Text {
                        text: root.offer-also ? "Watch" : "Watch Stream";
                        color: #ffffff; font-size: 14px; font-weight: 600;
                    }
                    watch-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.watch(); }
                    }
                }
            }
            if root.offer-also: VerticalLayout {
                alignment: center;
                IconButton {
                    size: 36px; glyph: 20px; radius: 8px;
                    icon: @image-url("icons/eye-plus.svg"); label: "Start watching multiple streams";
                    tint: #ffffff; fill: #4e5058cc;
                    clicked => { root.watch-also(); }
                }
            }
        }
        if root.live-badge && !root.stop-shown: LivePill { x: parent.width - self.width - 10px; y: 10px; }
        if root.stream-controls && (touch.has-hover || root.stream-muted || root.focused): HorizontalLayout {
            x: parent.width - self.preferred-width - 10px; y: parent.height - 32px - 10px; height: 32px;
            spacing: 6px;
            IconButton {
                size: 32px; glyph: 18px; radius: 16px;
                icon: root.stream-muted ? @image-url("icons/volume-x.svg") : @image-url("icons/volume-2.svg");
                label: root.stream-muted ? "Unmute" : "Mute"; tint: #ffffff; fill: #000000a6;
                clicked => { root.mute(!root.stream-muted); }
            }
            if root.focused && (touch.has-hover || root.full): IconButton {
                size: 32px; glyph: 18px; radius: 16px;
                icon: root.full ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg");
                label: root.full ? "Exit Full Screen" : "Full Screen"; tint: #ffffff; fill: #000000a6;
                clicked => { root.full-screen(!root.full); }
            }
        }
        ViewerStack {
            x: parent.width - self.width - (root.stop-shown ? 50px : 10px); y: 11px;
            viewers: root.viewers; names: root.viewer-names;
        }
        if root.stop-shown: IconButton {
            x: parent.width - self.width - 10px; y: 10px; height: self.size;
            icon: @image-url("icons/x.svg"); label: root.stop-label; tint: #ffffff;
            fill: #000000a6; radius: 16px;
            clicked => { root.stop(); }
        }
        if root.focused && !root.stream-controls && self.has-hover: IconButton {
            x: parent.width - self.width - 10px; y: parent.height - self.size - 10px; height: self.size;
            icon: root.full ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg");
            label: root.full ? "Exit Full Screen" : "Full Screen"; tint: #ffffff;
            fill: #000000a6; radius: 16px;
            clicked => { root.full-screen(!root.full); }
        }
    }
}

// A tile's name, at its bottom left.
component TileChip inherits Rectangle {
    in property <string> name;
    in property <bool> live;
    /// Why their tile may look wrong, such as a lost connection.
    in property <string> note;
    /// The tile's size.
    in property <length> tile-width;
    in property <length> tile-height;
    x: 10px; y: root.tile-height - self.height - 10px;
    width: min(root.tile-width - 20px, chip.preferred-width); height: 26px;
    border-radius: 6px; background: #000000a6;
    chip := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px;
        @children
        Text { text: root.name; color: #ffffff; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
        if root.live: Middle { LivePill { } }
        if root.note != "": Text { text: root.note; color: Theme.accent; font-size: 13px; vertical-alignment: center; overflow: elide; }
    }
}

// A stream's picture on the stage, or what shows until its first.
component StreamPicture inherits Rectangle {
    in property <image> frame;
    in property <string> status;
    /// How far it's zoomed in, and where the zoomed picture's corner is.
    in property <float> zoom: 1;
    in property <length> pan-x;
    in property <length> pan-y;
    Image {
        x: root.pan-x; y: root.pan-y; width: parent.width * root.zoom; height: parent.height * root.zoom;
        source: root.frame; image-fit: contain;
    }
    // The stage is black in every theme, so its note is a fixed grey.
    if root.frame.width == 0: Text {
        x: 16px; width: parent.width - 32px; height: parent.height;
        text: root.status; color: #b5b8c1; font-size: 14px;
        horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
    }
}

// The call's participants as tiles in a grid. A click on one shows it large,
// with the others in rows beneath, until a click beside it.
export component ParticipantGrid inherits Flickable {
    in property <[PersonRow]> participants;
    /// Each participant's newest camera picture, in the same order.
    in property <[image]> frames;
    /// This account's camera is on its way, until its first picture.
    in property <bool> camera-starting;
    in property <bool> sharing;
    in property <bool> share-live;
    in property <string> share-status;
    in property <image> share-frame;
    in property <[PersonRow]> share-viewers;
    in property <string> share-viewer-names;
    /// The streams of those who film too, in tiles of their own, as indexes
    /// of `participants`. Others' streams show in their own tiles.
    in property <[int]> stream-tiles;
    /// The streams being watched, and for each participant, one more than
    /// where theirs is among them, or 0 for none.
    in property <[WatchedStream]> watched-streams;
    in property <[int]> participant-watch;
    property <bool> watching-any: root.watched-streams.length > 0;
    /// The stream whose viewers show over it, and who watches it.
    in property <string> watch-user;
    in property <[PersonRow]> watch-viewers;
    in property <string> watch-viewer-names;
    /// The tile shown large, by its place: this account's shared screen
    /// first, then the streams' tiles, then the participants'; -1 for none.
    in property <int> focused: -1;
    /// Over the whole window: the large tile alone, edge to edge.
    in property <bool> full;
    /// Show the tile at this place large, or none for -1.
    callback focus-tile(int);
    callback full-screen(bool);
    /// Watch someone's stream alone, or as well as the others.
    callback watch-stream(string);
    callback watch-also(string);
    callback stop-watching(string);
    /// Mutes someone's stream here, or unmutes it.
    callback mute-stream(string, bool);
    /// Ends your own stream, from its tile.
    callback stop-sharing;
    /// A right click on someone, with where it was in the window.
    callback open-volume(PersonRow, length, length);
    /// A right click on a stream being watched, with where it was.
    callback open-stream-menu(PersonRow, length, length);
    /// Where the tiles are, so cameras are decoded only for tiles in sight,
    /// at their size: the columns, a tile's width and height, the gap, the
    /// first row's top, how far the grid is scrolled and its height; then
    /// the large tile's place, width and height.
    callback tiles(int, length, length, length, length, length, length, int, length, length);
    function report() {
        root.tiles(root.columns, root.tile-width, root.tile-height, root.gap, root.first-row, -root.content-y, root.height,
            root.focusing ? root.focused : -1, root.focusing ? root.focus-width : 0px, root.focusing ? root.focus-height : 0px);
    }
    init => { self.report(); }
    changed columns => { self.report(); }
    changed tile-width => { self.report(); }
    changed first-row => { self.report(); }
    changed content-y => { self.report(); }
    changed height => { self.report(); }
    changed focused => { self.report(); }
    changed focusing => { self.report(); }
    changed focus-width => { self.report(); }
    vertical-stretch: 1;
    property <length> gap: root.full ? 0px : 12px;
    property <length> inset: root.full ? 0px : 24px;
    property <length> span: self.width - 2 * self.inset;
    // Your shared screen leads the grid, then the streams with tiles of their own.
    property <int> extra: (root.sharing ? 1 : 0) + root.stream-tiles.length;
    property <int> count: root.participants.length + self.extra;
    property <bool> focusing: root.focused >= 0 && root.focused < self.count;
    // A few people take the columns, and the size, that make their tiles
    // largest within both the width and the height, so a short call above a
    // DM's messages shows everyone without scrolling. Side by side wins
    // unless stacking makes tiles a tenth larger. More people take tiles at
    // least 240px wide, and scroll.
    pure function fitted(columns: int) -> length {
        let rows = ceil(root.count / columns);
        min(420px, (root.span - (columns - 1) * root.gap) / columns,
            (root.height - 2 * root.inset - (rows - 1) * root.gap) / rows / 0.5625)
    }
    property <int> fewest: max(1, min(self.count, floor((self.span + self.gap) / (240px + self.gap))));
    property <int> best-fit: self.count >= 2 && self.fitted(2) * 1.1 > self.fitted(1)
        ? (self.count >= 3 && self.fitted(3) * 1.1 > self.fitted(2)
            ? (self.count >= 4 && self.fitted(4) * 1.1 > self.fitted(3) ? 4 : 3) : 2)
        : 1;
    // With a tile large, the others are small, 120 to 192px wide, in rows
    // beneath it; full screen shows it alone.
    property <int> others: self.count - 1;
    property <length> strip-width: self.others <= 0 ? 0px
        : max(120px, min(192px, (self.span - (self.others - 1) * self.gap) / self.others));
    property <int> strip-columns: max(1, min(self.others, floor((self.span + self.gap) / (self.strip-width + self.gap))));
    property <int> strip-rows: root.full || self.others <= 0 ? 0 : ceil(self.others / self.strip-columns);
    property <length> strip-height: self.strip-rows * self.strip-width * 0.5625 + max(0, self.strip-rows - 1) * self.gap;
    property <length> under-focus: self.strip-rows > 0 ? self.gap + self.strip-height : 0px;
    property <length> focus-width: root.full ? self.width
        : min(self.span, max(160px, self.height - 2 * self.inset - self.under-focus) / 0.5625);
    property <length> focus-height: root.full ? self.height : self.focus-width * 0.5625;
    property <length> focus-top: root.full ? 0px : max(self.inset, (self.height - self.focus-height - self.under-focus) / 2);
    property <int> columns: self.focusing ? (root.full ? 0 : self.strip-columns)
        : self.count <= 4 ? self.best-fit : self.fewest;
    property <length> tile-width: self.focusing ? self.strip-width
        : self.count <= 4 ? max(160px, self.fitted(self.columns))
        : min(420px, (self.span - (self.columns - 1) * self.gap) / self.columns);
    property <length> tile-height: self.tile-width * 0.5625;
    // The tiles in rows: all of them, or all but the large one.
    property <int> placed: self.focusing ? self.others : self.count;
    property <int> rows: ceil(self.placed / max(1, self.columns));
    property <length> grid-height: self.rows * self.tile-height + max(0, self.rows - 1) * self.gap;
    property <length> grid-width: self.columns * self.tile-width + max(0, self.columns - 1) * self.gap;
    property <length> first-row: self.focusing ? self.focus-top + self.focus-height + self.gap
        : max(self.inset, (self.height - self.grid-height) / 2);
    content-height: self.focusing ? max(self.height, self.focus-top + self.focus-height + self.under-focus + self.inset)
        : max(self.height, self.grid-height + 2 * self.inset);
    pure function large(slot: int) -> bool { root.focusing && slot == root.focused }
    // The place in the rows of the tile at `slot`, which skip the large one.
    pure function place(slot: int) -> int { root.focusing && slot > root.focused ? slot - 1 : slot }
    pure function tile-x(slot: int) -> length {
        root.large(slot) ? (root.width - root.focus-width) / 2
            : (root.width - root.grid-width) / 2 + mod(root.place(slot), max(1, root.columns)) * (root.tile-width + root.gap)
    }
    pure function tile-y(slot: int) -> length {
        root.large(slot) ? root.focus-top
            : root.first-row + floor(root.place(slot) / max(1, root.columns)) * (root.tile-height + root.gap)
    }
    if root.sharing: StageTile {
        x: root.tile-x(0); y: root.tile-y(0);
        width: root.large(0) ? root.focus-width : root.tile-width;
        height: root.large(0) ? root.focus-height : root.tile-height;
        visible: !root.full || root.large(0);
        focused: root.large(0); full: root.full;
        background: #000000;
        label: "Your screen, " + root.share-status;
        viewers: root.share-viewers; viewer-names: root.share-viewer-names;
        stop-label: "Stop streaming";
        stop => { root.stop-sharing(); }
        clicked => { if !self.focused { root.focus-tile(0); } }
        full-screen(on) => { root.full-screen(on); }
        unfocus => { root.focus-tile(-1); }
        Image { width: parent.width; height: parent.height; source: root.share-frame; image-fit: contain; }
        if root.share-frame.width == 0: VerticalLayout {
            alignment: center; spacing: 10px;
            // Black in every theme, as a stream's stage.
            Image { height: 34px; source: @image-url("icons/screen-share.svg"); image-fit: contain; colorize: #b5b8c1; }
            Text { text: root.share-status; color: #b5b8c1; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
        }
        TileChip { tile-width: parent.width; tile-height: parent.height; name: "Your screen"; live: root.share-live; note: !root.share-live && root.share-frame.width > 0 ? root.share-status : ""; }
    }
    for index[position] in root.stream-tiles: stream := StageTile {
        property <int> slot: position + (root.sharing ? 1 : 0);
        property <PersonRow> person: root.participants[index];
        property <int> watch-index: root.participant-watch[index] - 1;
        property <bool> watched: self.watch-index >= 0;
        property <WatchedStream> shown: root.watched-streams[self.watch-index];
        x: root.tile-x(self.slot); y: root.tile-y(self.slot);
        width: root.large(self.slot) ? root.focus-width : root.tile-width;
        height: root.large(self.slot) ? root.focus-height : root.tile-height;
        visible: !root.full || root.large(self.slot);
        focused: root.large(self.slot); full: root.full;
        background: #000000;
        label: self.watched ? self.person.name + "'s screen" : "Watch " + self.person.name + "'s stream";
        viewers: self.watched && self.person.id == root.watch-user ? root.watch-viewers : [];
        viewer-names: self.watched && self.person.id == root.watch-user ? root.watch-viewer-names : "";
        stop-label: self.watched ? "Stop watching" : "";
        offer-watch: !self.watched; offer-also: root.watching-any;
        live-badge: true; stream-controls: self.watched; stream-muted: self.shown.muted;
        watch => { root.watch-stream(self.person.id); }
        watch-also => { root.watch-also(self.person.id); }
        mute(muted) => { root.mute-stream(self.person.person, muted); }
        clicked => {
            if !self.watched {
                root.watch-stream(self.person.id);
            } else if !self.focused {
                root.focus-tile(self.slot);
            }
        }
        right-clicked(x, y) => { if self.watched { root.open-stream-menu(self.person, x, y); } else { root.open-volume(self.person, x, y); } }
        stop => { root.stop-watching(self.person.id); }
        full-screen(on) => { root.full-screen(on); }
        unfocus => { if self.watched { root.focus-tile(-1); } else { root.watch-stream(self.person.id); } }
        zoomable: self.watched;
        if stream.watched: StreamPicture {
            frame: stream.shown.frame; status: stream.shown.status;
            zoom: stream.zoom; pan-x: stream.pan-x; pan-y: stream.pan-y;
        }
        if !stream.watched: Rectangle {
            background: #1e1f22;
            Image {
                y: parent.height / 2 - 52px; height: 26px;
                source: @image-url("icons/screen-share.svg"); image-fit: contain; colorize: #80848e;
            }
        }
        TileChip {
            tile-width: parent.width; tile-height: parent.height; name: stream.person.name; live: false;
            Image { source: @image-url("icons/monitor.svg"); width: 14px; image-fit: contain; colorize: #ffffff; }
        }
    }
    for person[position] in root.participants: tile := StageTile {
        property <int> slot: position + root.extra;
        x: root.tile-x(self.slot); y: root.tile-y(self.slot);
        width: root.large(self.slot) ? root.focus-width : root.tile-width;
        height: root.large(self.slot) ? root.focus-height : root.tile-height;
        visible: !root.full || root.large(self.slot);
        focused: root.large(self.slot); full: root.full;
        property <image> frame: person.video ? root.frames[position] : @image-url("");
        property <bool> filmed: self.frame.width > 0;
        // Someone who shares without a camera shows the stream in their tile,
        // once it's watched; until then a click watches it.
        property <bool> streams-here: person.live && !person.local && !person.video;
        property <int> watch-index: root.participant-watch[position] - 1;
        property <bool> watched: self.streams-here && self.watch-index >= 0;
        property <WatchedStream> shown: root.watched-streams[self.watch-index];
        zoomable: self.watched;
        background: self.filmed || self.watched ? #000000 : Theme.raised;
        label: person.name + ", " + person.status + (person.video ? ", camera on" : "");
        viewers: self.watched && person.id == root.watch-user ? root.watch-viewers : [];
        viewer-names: self.watched && person.id == root.watch-user ? root.watch-viewer-names : "";
        stop-label: self.watched ? "Stop watching" : "";
        offer-watch: self.streams-here && !self.watched; offer-also: root.watching-any;
        live-badge: self.streams-here; stream-controls: self.watched; stream-muted: self.shown.muted;
        watch => { root.watch-stream(person.id); }
        watch-also => { root.watch-also(person.id); }
        mute(muted) => { root.mute-stream(person.person, muted); }
        clicked => {
            if self.streams-here && !self.watched {
                root.watch-stream(person.id);
            } else if !self.focused {
                root.focus-tile(self.slot);
            }
        }
        right-clicked(x, y) => { if self.watched { root.open-stream-menu(person, x, y); } else { root.open-volume(person, x, y); } }
        stop => { root.stop-watching(person.id); }
        full-screen(on) => { root.full-screen(on); }
        unfocus => { if self.streams-here && !self.watched { root.watch-stream(person.id); } else { root.focus-tile(-1); } }
        if tile.filmed: Image { width: tile.width; height: tile.height; source: tile.frame; image-fit: contain; }
        if tile.watched: StreamPicture {
            frame: tile.shown.frame; status: tile.shown.status;
            zoom: tile.zoom; pan-x: tile.pan-x; pan-y: tile.pan-y;
        }
        if !tile.filmed && !tile.watched: Avatar {
            size: min(80px, parent.height * 0.45); initial: person.initial; tint: person.tint; picture: person.picture;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 - 8px;
            // Faint behind the Watch buttons of a stream not watched yet.
            opacity: tile.streams-here ? 0.3 : person.connected ? 1 : 0.5;
        }
        // Drawn over the camera's picture.
        Rectangle {
            border-radius: tile.border-radius; border-width: person.speaking ? 3px : 0px; border-color: Theme.live;
        }
        if person.local && root.camera-starting: Rectangle {
            x: 10px; y: 10px; height: 26px;
            width: starting-label.preferred-width + 20px; border-radius: 13px;
            background: #000000a6; opacity: (0.6 + 0.4 * sin(animation-tick() / 1ms * 0.36deg));
            starting-label := Text { text: "Starting camera..."; color: #ffffff; font-size: 13px; font-weight: 700; }
        }
        TileChip {
            tile-width: parent.width; tile-height: parent.height;
            // A stream with a tile of its own is LIVE there; one in this tile
            // says so at its top.
            name: person.name; live: person.live && person.local;
            note: person.status != "Muted" && person.status != "Deafened" && person.status != "Speaking" && person.status != "Listening" ? person.status : "";
            if tile.streams-here: Image { source: @image-url("icons/monitor.svg"); width: 14px; image-fit: contain; colorize: #ffffff; }
            if person.muted && !person.deafened: Image { source: @image-url("icons/mic-off.svg"); width: 14px; image-fit: contain; colorize: Theme.danger; }
            if person.deafened: Image { source: @image-url("icons/headphone-off.svg"); width: 14px; image-fit: contain; colorize: Theme.danger; }
        }
    }
}

// The call's controls under the stage: mute, deafen, the soundboard, the
// camera, share the screen, and leave.
// A button in the call bar, as Discord's: an icon on the bar's dark fill,
// lighter under the pointer; red while it warns, as a muted microphone
// does, and green while it's live, as a stream is. Its name shows above it
// while the pointer is on it.
component BarButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> alert;
    in property <bool> live;
    callback clicked;
    width: 44px; height: 40px;
    border-radius: 8px;
    background: root.live ? (touch.has-hover ? #248046 : #23a55a.with-alpha(0.3))
        : root.alert ? (touch.has-hover ? Theme.danger.with-alpha(0.32) : Theme.danger.with-alpha(0.2))
        : touch.has-hover && root.enabled ? Theme.overlay.with-alpha(0.09) : transparent;
    animate background { duration: Theme.quick; }
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        source: root.icon; width: 20px; height: 20px; image-fit: contain;
        colorize: root.live ? #ffffff : root.alert ? Theme.danger-text : Theme.text;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { Tip.text = ""; root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.label;
                Tip.side = 0;
                Tip.x = root.absolute-position.x + root.width / 2;
                Tip.y = root.absolute-position.y;
            } else if Tip.text == root.label {
                Tip.text = "";
            }
        }
    }
}

// The caret beside a call bar button that opens its menu, pointing up while
// the menu is open, as Discord's does.
component BarCaret inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    in property <bool> enabled: true;
    callback clicked;
    width: 22px; height: 40px; border-radius: 8px;
    background: (touch.has-hover || root.open) && root.enabled ? Theme.overlay.with-alpha(0.09) : transparent;
    animate background { duration: Theme.quick; }
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        source: root.open ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
        width: 16px; height: 16px; image-fit: contain; colorize: Theme.text;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { Tip.text = ""; root.clicked(); }
    }
}

// A group of call bar buttons on one dark, rounded fill.
component BarGroup inherits Rectangle {
    background: Theme.raised; border-radius: 10px;
    border-width: 1px; border-color: Theme.edge;
    width: group-row.preferred-width; height: 48px;
    group-row := HorizontalLayout {
        padding: 4px; spacing: 2px;
        @children
    }
}

// The bar under a call, as Discord's: the microphone and the camera, each
// with its menu's caret; your stream, with its menu's caret while it's on,
// the soundboard and the call's other options; and leaving.
export component CallControls inherits HorizontalLayout {
    in property <bool> muted;
    in property <bool> deafened;
    in property <bool> voice-ready;
    in property <bool> voice-leaving;
    in property <bool> can-share;
    in property <bool> sharing;
    /// The call carries camera video, and this account's camera is on.
    in property <bool> can-film;
    in property <bool> camera-on;
    /// The camera is on its way, until its first picture.
    in property <bool> camera-starting;
    /// Which of the bar's menus is open, whose caret points up.
    in property <bool> mic-menu-open;
    in property <bool> camera-menu-open;
    in property <bool> share-menu-open;
    in property <bool> more-menu-open;
    callback toggle-mute;
    callback toggle-deafen;
    callback toggle-camera;
    callback toggle-share;
    /// The call has Discord's soundboard.
    in property <bool> can-soundboard;
    /// Each menu opens above the point in the window it's given.
    callback open-share-menu(length, length);
    callback open-mic-menu(length, length);
    callback open-camera-menu(length, length);
    callback open-more-menu(length, length);
    /// The soundboard, opened above this point in the window.
    callback open-soundboard(length, length);
    callback leave-voice;
    alignment: center; spacing: 8px; padding: 16px; padding-top: 8px;
    devices := BarGroup {
        BarButton {
            icon: root.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
            label: root.muted ? "Unmute" : "Mute"; alert: root.muted;
            enabled: root.voice-ready;
            clicked => { root.toggle-mute(); }
        }
        BarCaret {
            label: "Input Options"; open: root.mic-menu-open;
            clicked => { root.open-mic-menu(devices.absolute-position.x, devices.absolute-position.y); }
        }
        if root.can-film: BarButton {
            icon: root.camera-on ? @image-url("icons/video.svg") : @image-url("icons/video-off.svg");
            label: root.camera-starting ? "Starting camera..." : root.camera-on ? "Turn Off Camera" : "Turn On Camera";
            live: root.camera-on;
            enabled: root.voice-ready; opacity: root.camera-starting ? (0.6 + 0.4 * sin(animation-tick() / 1ms * 0.36deg)) : 1;
            clicked => { root.toggle-camera(); }
        }
        if root.can-film: BarCaret {
            label: "Video Options"; open: root.camera-menu-open;
            clicked => { root.open-camera-menu(devices.absolute-position.x + devices.width - 44px - 22px - 4px, devices.absolute-position.y); }
        }
    }
    actions := BarGroup {
        if root.can-share || root.sharing: share := BarButton {
            icon: @image-url("icons/screen-share.svg");
            label: root.sharing ? "Stream Options" : "Share Your Screen";
            live: root.sharing;
            enabled: root.voice-ready;
            clicked => { root.open-share-menu(actions.absolute-position.x, actions.absolute-position.y); }
        }
        if root.sharing: BarCaret {
            label: "Stream Options"; open: root.share-menu-open;
            clicked => { root.open-share-menu(actions.absolute-position.x, actions.absolute-position.y); }
        }
        if root.can-soundboard: BarButton {
            icon: @image-url("icons/soundboard.svg"); label: "Open Soundboard";
            enabled: root.voice-ready;
            clicked => { root.open-soundboard(self.absolute-position.x, actions.absolute-position.y); }
        }
        more := BarButton {
            icon: @image-url("icons/ellipsis.svg"); label: "More Options";
            clicked => { root.open-more-menu(self.absolute-position.x, actions.absolute-position.y); }
        }
    }
    Rectangle {
        width: 64px; height: 48px; border-radius: 10px;
        background: leave-touch.has-hover ? Theme.danger-hover : Theme.danger;
        animate background { duration: Theme.quick; }
        opacity: root.voice-leaving ? 0.5 : 1;
        accessible-role: button; accessible-label: "Disconnect"; accessible-enabled: !root.voice-leaving;
        accessible-action-default => { if !root.voice-leaving { root.leave-voice(); } }
        Image { source: @image-url("icons/phone-off.svg"); width: 22px; height: 22px; colorize: Theme.on-danger; }
        leave-touch := TouchArea {
            enabled: !root.voice-leaving; mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.leave-voice(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = "Disconnect"; Tip.side = 0;
                    Tip.x = parent.absolute-position.x + parent.width / 2; Tip.y = parent.absolute-position.y;
                } else if Tip.text == "Disconnect" {
                    Tip.text = "";
                }
            }
        }
    }
}

// A row of the call bar's menus that opens a list beside it, as Discord's
// Input Device does: its name, what's chosen under it, and an arrow.
component CallSubRow inherits MenuItem {
    plain: true; submenu: true;
}

// A slider in the call bar's menus, as Discord's: its name above a thin
// blurple bar, without a number.
component CallSlider inherits VerticalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> maximum: 200;
    callback changed(int);
    callback committed(int);
    padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 4px; spacing: 6px;
    Text { text: root.label; color: Theme.text; font-size: 14px; font-weight: 600; }
    VolumeSlider {
        label: ""; shown: ""; maximum: root.maximum; full-mark: false;
        value <=> root.value;
        changed(volume) => { root.changed(volume); }
        committed(volume) => { root.committed(volume); }
    }
}

// A list a call bar menu opens beside a row: a choice marked with a check.
component CallChoices inherits Rectangle {
    in property <[string]> choices;
    in property <int> current;
    in property <string> empty;
    callback chose(int);
    background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    height: choice-rows.preferred-height;
    TouchArea { }
    choice-rows := VerticalLayout {
        padding: 6px; spacing: 2px;
        for choice[index] in root.choices: MenuItem {
            text: choice; checked: index == root.current;
            clicked => { root.chose(index); }
        }
        if root.choices.length == 0: HorizontalLayout {
            padding: 8px;
            Label { text: root.empty; }
        }
    }
}

// The microphone's menu from its caret in the call bar, as Discord's: the
// input device, the input profile and the output device, each a list
// beside it; the input volume, the microphone's level and the output
// volume; deafening; and the voice settings.
export component CallMicMenu inherits Rectangle {
    in property <[string]> microphones;
    in property <int> microphone-index;
    in property <[string]> speakers;
    in property <int> speaker-index;
    /// Discord's input profiles, offered on Discord calls.
    in property <bool> profiles;
    in property <int> input-profile;
    in-out property <int> microphone-volume;
    in-out property <int> speaker-volume;
    /// The microphone's level, from 0 to 1.
    in property <float> input-level;
    in property <bool> deafened;
    callback select-microphone(int);
    callback select-speaker(int);
    callback choose-profile(int);
    /// A volume moved, and the last of a drag.
    callback volumes-changed;
    callback volumes-committed;
    callback toggle-deafen;
    callback settings;
    property <[string]> profile-names: ["Voice Isolation", "Studio", "Custom"];
    property <length> menu-width: 280px;
    property <length> sub-width: 260px;
    // The list open beside the menu: 0 the microphones, 1 the profiles, 2
    // the speakers; and how far down it starts.
    property <int> sub: -1;
    property <length> sub-y;
    property <[string]> sub-choices: root.sub == 0 ? root.microphones : root.sub == 1 ? root.profile-names : root.speakers;
    property <int> sub-current: root.sub == 0 ? root.microphone-index : root.sub == 1 ? root.input-profile : root.speaker-index;
    // Tall enough from the start for the longest list beside it.
    property <length> tallest-list: max(root.microphones.length, root.speakers.length, 3) * 34px + 12px;
    out property <length> content-width: root.menu-width + 4px + root.sub-width;
    out property <length> content-height: max(panel.height, root.tallest-list);
    function open-list(which: int, y: length) {
        root.sub = which;
        root.sub-y = y;
    }
    panel := Rectangle {
        x: 0px; y: root.content-height - self.height;
        width: root.menu-width; height: rows.preferred-height;
        background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
        TouchArea { }
        rows := VerticalLayout {
            padding: 6px; spacing: 2px;
            input-row := CallSubRow {
                text: "Input Device";
                subtitle: root.microphone-index >= 0 && root.microphone-index < root.microphones.length ? root.microphones[root.microphone-index] : "None";
                highlighted: self.has-hover || root.sub == 0;
                hovered => { root.open-list(0, panel.y + self.y + 6px); }
                clicked => { root.open-list(0, panel.y + self.y + 6px); }
            }
            if root.profiles: CallSubRow {
                text: "Input Profile"; subtitle: root.profile-names[root.input-profile];
                highlighted: self.has-hover || root.sub == 1;
                hovered => { root.open-list(1, panel.y + self.y + 6px); }
                clicked => { root.open-list(1, panel.y + self.y + 6px); }
            }
            CallSubRow {
                text: "Output Device";
                subtitle: root.speaker-index >= 0 && root.speaker-index < root.speakers.length ? root.speakers[root.speaker-index] : "None";
                highlighted: self.has-hover || root.sub == 2;
                hovered => { root.open-list(2, panel.y + self.y + 6px); }
                clicked => { root.open-list(2, panel.y + self.y + 6px); }
            }
            Rectangle {
                height: 9px;
                Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
            }
            CallSlider {
                label: "Input Volume"; value <=> root.microphone-volume;
                changed => { root.sub = -1; root.volumes-changed(); }
                committed => { root.volumes-committed(); }
            }
            VerticalLayout {
                padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 8px;
                Text { text: "Input Level"; color: Theme.text; font-size: 14px; font-weight: 600; }
                HorizontalLayout {
                    height: 16px; spacing: 3px;
                    accessible-role: progress-indicator; accessible-label: "Input level";
                    accessible-value: round(root.input-level * 100) + "%";
                    for tick in 36: Rectangle {
                        border-radius: 1.5px;
                        background: (tick + 0.5) / 36 <= root.input-level ? #23a55a : Theme.line;
                    }
                }
            }
            CallSlider {
                label: "Output Volume"; value <=> root.speaker-volume;
                changed => { root.sub = -1; root.volumes-changed(); }
                committed => { root.volumes-committed(); }
            }
            Rectangle {
                height: 9px;
                Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
            }
            MenuItem {
                text: "Deafen"; plain: true; checkbox: true; checked: root.deafened;
                hovered => { root.sub = -1; }
                clicked => { root.toggle-deafen(); }
            }
            MenuItem {
                text: "Voice Settings"; icon: @image-url("icons/settings.svg");
                hovered => { root.sub = -1; }
                clicked => { root.settings(); }
            }
        }
    }
    if root.sub >= 0: CallChoices {
        x: root.menu-width + 4px; width: root.sub-width;
        y: max(0px, min(root.sub-y - 6px, root.content-height - self.height));
        choices: root.sub-choices; current: root.sub-current;
        empty: root.sub == 0 ? "No microphones found." : "No speakers found.";
        chose(index) => {
            if root.sub == 0 { root.select-microphone(index); }
            else if root.sub == 1 { root.choose-profile(index); }
            else { root.select-speaker(index); }
        }
    }
}

// The camera's menu from its caret in the call bar, as Discord's: the
// camera, in a list beside it; a preview of it; and the video settings.
export component CallCameraMenu inherits Rectangle {
    in property <[string]> cameras;
    in property <int> camera-index;
    callback select-camera(int);
    callback preview;
    callback settings;
    property <length> menu-width: 260px;
    property <length> sub-width: 240px;
    property <bool> list-open;
    out property <length> content-width: root.menu-width + 4px + root.sub-width;
    out property <length> content-height: max(panel.height, max(1, root.cameras.length) * 34px + 12px);
    panel := Rectangle {
        x: 0px; y: root.content-height - self.height;
        width: root.menu-width; height: rows.preferred-height;
        background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
        TouchArea { }
        rows := VerticalLayout {
            padding: 6px; spacing: 2px;
            camera-row := CallSubRow {
                text: "Camera";
                subtitle: root.camera-index >= 0 && root.camera-index < root.cameras.length ? root.cameras[root.camera-index] : "None";
                highlighted: self.has-hover || root.list-open;
                hovered => { root.list-open = true; }
                clicked => { root.list-open = true; }
            }
            Rectangle {
                height: 9px;
                Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
            }
            MenuItem {
                text: "Preview Camera"; icon: @image-url("icons/eye.svg");
                hovered => { root.list-open = false; }
                clicked => { root.preview(); }
            }
            MenuItem {
                text: "Video Settings"; icon: @image-url("icons/settings.svg");
                hovered => { root.list-open = false; }
                clicked => { root.settings(); }
            }
        }
    }
    if root.list-open: CallChoices {
        x: root.menu-width + 4px; width: root.sub-width;
        y: max(0px, min(panel.y, root.content-height - self.height));
        choices: root.cameras; current: root.camera-index;
        empty: "No cameras found.";
        chose(index) => { root.select-camera(index); }
    }
}

// The call's other options, from the bar's "..." as Discord's: inviting to
// the channel, the grid, and the voice and video settings.
export component CallMoreMenu inherits Rectangle {
    in property <bool> can-invite;
    /// Every tile shows alike; off, one is shown large.
    in property <bool> grid-view;
    callback invite;
    callback toggle-grid;
    callback settings;
    width: 260px; height: rows.preferred-height;
    background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    TouchArea { }
    rows := VerticalLayout {
        padding: 6px; spacing: 2px;
        if root.can-invite: MenuItem {
            text: "Invite to Voice"; icon: @image-url("icons/user-plus.svg");
            clicked => { root.invite(); }
        }
        if root.can-invite: Rectangle {
            height: 9px;
            Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
        }
        MenuItem {
            text: "Grid View"; plain: true; checkbox: true; checked: root.grid-view;
            clicked => { root.toggle-grid(); }
        }
        Rectangle {
            height: 9px;
            Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
        }
        MenuItem {
            text: "Voice & Video Settings"; icon: @image-url("icons/settings.svg");
            clicked => { root.settings(); }
        }
    }
}

// A watched stream's menu, from a right click on it, as Discord's: stop
// watching; its sound's mute and volume; Stream Attenuation; and the rest
// of its streamer's menu.
export component StreamMenu inherits Rectangle {
    in-out property <int> stream-volume;
    in property <bool> attenuation;
    callback stop-watching;
    /// Mutes the stream, or unmutes it to the volume it had.
    callback mute(bool);
    callback volume-changed(int, bool);
    callback toggle-attenuation;
    callback more;
    property <int> unmuted: 100;
    width: 260px; height: rows.preferred-height;
    background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    TouchArea { }
    rows := VerticalLayout {
        padding: 6px; spacing: 2px;
        MenuItem {
            text: "Stop Watching"; icon: @image-url("icons/screen-share-off.svg");
            clicked => { root.stop-watching(); }
        }
        Rectangle {
            height: 9px;
            Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
        }
        MenuItem {
            text: "Mute"; plain: true; checkbox: true; checked: root.stream-volume == 0;
            clicked => {
                if root.stream-volume == 0 {
                    root.stream-volume = max(1, root.unmuted);
                    root.mute(false);
                } else {
                    root.unmuted = root.stream-volume;
                    root.stream-volume = 0;
                    root.mute(true);
                }
                root.volume-changed(root.stream-volume, true);
            }
        }
        CallSlider {
            label: "Stream Volume"; maximum: 500; value <=> root.stream-volume;
            changed(volume) => { root.volume-changed(volume, false); }
            committed(volume) => { root.volume-changed(volume, true); }
        }
        Rectangle {
            height: 9px;
            Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
        }
        MenuItem {
            text: "Stream Attenuation"; subtitle: "Automatically reduce stream volume when people are talking.";
            plain: true; checkbox: true; checked: root.attenuation;
            clicked => { root.toggle-attenuation(); }
        }
        Rectangle {
            height: 9px;
            Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
        }
        MenuItem {
            text: "More Options"; plain: true; submenu: true;
            clicked => { root.more(); }
        }
    }
}

// A call ringing this account in a DM that isn't open: who, and a way to answer.
export component IncomingCall inherits Rectangle {
    in property <string> incoming-room;
    in property <string> incoming-name;
    in property <string> incoming-detail;
    in property <string> incoming-initial;
    in property <color> incoming-tint;
    in property <image> incoming-picture;
    callback answer-call(string, bool);
    width: 300px; height: incoming-content.preferred-height;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
    drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
    accessible-role: groupbox;
    accessible-label: "Incoming call from " + root.incoming-name;
    // Clicks on the card never reach what's under it.
    TouchArea { }
    incoming-content := VerticalLayout {
        padding: 20px; spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 92px; height: 92px;
                // A ring that pulses while it rings.
                Rectangle {
                    border-radius: self.width / 2; border-width: 3px; border-color: Theme.live;
                    opacity: 0.45 + 0.4 * sin(animation-tick() / 1ms * 0.36deg);
                }
                Avatar {
                    x: 10px; y: 10px; size: 72px;
                    initial: root.incoming-initial; tint: root.incoming-tint; picture: root.incoming-picture;
                }
            }
        }
        Text { text: root.incoming-name; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        Text { text: root.incoming-detail; color: Theme.secondary; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
        HorizontalLayout {
            alignment: center; spacing: 20px; padding-top: 6px;
            CallButton {
                icon: @image-url("icons/phone-off.svg"); label: "Decline"; fill: Theme.danger;
                clicked => { root.answer-call(root.incoming-room, false); }
            }
            CallButton {
                icon: @image-url("icons/phone.svg"); label: "Accept"; fill: Theme.live;
                clicked => { root.answer-call(root.incoming-room, true); }
            }
        }
    }
}

// Switching voice channels asks first, over everything else, and so does
// joining one to watch a stream. Clicking
// outside or Escape cancels; Enter switches. The dialog stays in the tree
// so it can fade out, keeping its text while it goes.
export component SwitchDialog inherits Rectangle {
    /// It asks; false while it fades out.
    in property <bool> switching;
    in property <string> switch-text;
    /// It joins a call from none, to watch someone's stream.
    in property <bool> joins;
    callback cancel-switch;
    callback confirm-switch;
    /// It takes the keyboard while it asks, and lets it go after.
    public function focus-keys() { switch-keys.focus(); }
    public function release-keys() { switch-keys.clear-focus(); }
    // How far it's open, from 0 to 1; see Popup.
    property <float> motion: root.switching ? 1 : 0;
    animate motion { duration: Popup.duration; easing: ease-out-quad; }
    visible: root.motion > 0;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { enabled: root.switching; clicked => { root.cancel-switch(); } }
    Rectangle {
        width: min(420px, root.width - 48px); height: switch-content.preferred-height;
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.joins ? "Watch stream?" : "Switch voice channel?";
        // Clicks on the dialog itself never reach the backdrop.
        TouchArea { enabled: root.switching; }
        switch-keys := FocusScope {
            enabled: root.switching;
            key-pressed(event) => {
                if event.text == Key.Escape { root.cancel-switch(); return accept; }
                if event.text == "\n" { root.confirm-switch(); return accept; }
                return reject;
            }
            switch-content := VerticalLayout {
                padding: 20px; spacing: 18px;
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 40px; height: 40px; border-radius: 20px; background: Theme.accent-soft;
                            Image { source: @image-url("icons/volume-2.svg"); width: 20px; height: 20px; colorize: Theme.accent; }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px; horizontal-stretch: 1;
                        Text { text: root.joins ? "Watch stream?" : "Switch voice channel?"; color: Theme.text; font-size: 18px; font-weight: 700; }
                        Text { text: root.switch-text; color: Theme.secondary; font-size: 15px; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    // A fading dialog no longer acts.
                    ActionButton { text: "Cancel"; ghost: true; clicked => { if root.switching { root.cancel-switch(); } } }
                    ActionButton { text: root.joins ? "Join" : "Switch channel"; primary: true; clicked => { if root.switching { root.confirm-switch(); } } }
                }
            }
        }
    }
}

// The microphone's level in the input menu, as a row of segments.
export component InputLevel inherits VerticalLayout {
    /// From 0 to 1.
    in property <float> input-level;
    in property <bool> muted;
    /// Why the level can't be shown, if it can't.
    in property <string> meter-note;
    padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 8px;
    Text { text: "INPUT LEVEL"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
    HorizontalLayout {
        height: 10px; spacing: 3px;
        accessible-role: progress-indicator;
        accessible-label: "Input level";
        accessible-value: round(root.input-level * 100) + "%" + (root.muted ? ", muted" : "");
        // Muted, the level still shows, in a faded green: heard here, sent nowhere.
        for segment in 24: Rectangle {
            border-radius: 2px;
            background: (segment + 0.5) / 24 > root.input-level ? Theme.line
                : root.muted ? Theme.live.with-alpha(0.4) : Theme.live;
        }
    }
    if root.meter-note != "": Label { text: root.meter-note; }
    if root.meter-note == "" && root.muted: Label { text: "Muted. Nothing you say is sent."; }
}

/// A screen in the share menu, and once it's taken, a picture of it.
export struct ShareScreen { title: string, picture: image, icon: image }

// A choice in the share dialog, as Discord's: the picture across the tile,
// and under it the app's icon and name. A click shares it at once.
component ShareTile inherits Rectangle {
    in property <string> text;
    in property <image> picture;
    in property <image> icon;
    /// Shown, faint, until a picture comes, and for what has none.
    in property <image> placeholder;
    callback clicked;
    accessible-role: button;
    accessible-label: "Share " + root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <bool> lit: pointer.has-hover || focus.has-focus;
    preview := Rectangle {
        y: 0px; height: root.width * 9 / 16;
        border-radius: 4px; background: #000000; clip: true;
        // A picture of a couple of pixels is a minimized window's.
        if root.picture.width <= 4 && root.icon.width > 0: Image {
            width: 48px; height: 48px; source: root.icon; image-fit: contain;
        }
        if root.picture.width <= 4 && root.icon.width == 0: Image {
            width: 40px; height: 40px; source: root.placeholder; image-fit: contain; colorize: #6d6f78;
        }
        Image { width: parent.width; height: parent.height; source: root.picture; image-fit: contain; }
        Rectangle { background: root.lit ? #ffffff14 : transparent; }
        Rectangle {
            border-radius: 4px; border-width: root.lit ? 2px : 0px; border-color: Theme.accent;
        }
    }
    HorizontalLayout {
        y: preview.height + 8px; height: 22px; spacing: 8px;
        if root.icon.width > 0: Image {
            width: 18px; source: root.icon; image-fit: contain;
        }
        Text {
            text: root.text; color: root.lit ? Theme.text : Theme.secondary;
            font-size: 15px; font-weight: 600; overflow: elide; vertical-alignment: center;
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

// A tab along the top of the share dialog.
component ShareTab inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> checked;
    callback clicked;
    horizontal-stretch: 1; border-radius: 6px;
    background: root.checked ? Theme.hover : tab-touch.has-hover ? Theme.hover.with-alpha(0.5) : transparent;
    accessible-role: tab; accessible-label: root.text; accessible-item-selected: root.checked;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        alignment: center; spacing: 8px;
        Image {
            width: 18px; source: root.icon; image-fit: contain;
            colorize: root.checked || tab-touch.has-hover ? Theme.text : Theme.secondary;
        }
        Text {
            text: root.text; font-size: 15px; font-weight: 600; vertical-alignment: center;
            color: root.checked || tab-touch.has-hover ? Theme.text : Theme.secondary;
        }
    }
    tab-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A row of chips to pick one of, as the stream settings show resolutions and
// frame rates.
component ChoiceChip inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked;
    callback clicked;
    height: root.detail != "" ? 40px : 30px; horizontal-stretch: 1; border-radius: 6px;
    background: root.checked ? Theme.accent : chip-touch.has-hover ? Theme.hover : Theme.sunken;
    accessible-role: button; accessible-label: root.text + (root.detail != "" ? ", " + root.detail : "");
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        alignment: center;
        Text {
            text: root.text; font-size: 12px; font-weight: root.detail != "" ? 700 : 600; horizontal-alignment: center;
            color: root.checked ? Theme.on-accent : Theme.text;
        }
        if root.detail != "": Text {
            text: root.detail; font-size: 10px; horizontal-alignment: center;
            color: root.checked ? Theme.on-accent : Theme.muted;
        }
    }
    chip-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component ShareHeading inherits Text {
    color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
}

// The stream's quality, behind the share dialog's gear: presets, the
// resolution, the frame rate, the encoder's effort and the stream's sound.
component ShareSettings inherits Rectangle {
    in-out property <int> pick-resolution;
    in-out property <int> pick-fps;
    in-out property <bool> pick-high-quality;
    in-out property <bool> pick-audio;
    background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    height: settings-content.preferred-height;
    TouchArea {}
    settings-content := VerticalLayout {
        padding: 12px; spacing: 6px;
        ShareHeading { text: "PRESETS"; }
        HorizontalLayout {
            spacing: 4px;
            for preset in [
                { name: "Smoother Video", detail: "720p 60", resolution: 1, fps: 60, high: false },
                { name: "Better Readability", detail: "Source 15", resolution: 4, fps: 15, high: true },
                { name: "Games", detail: "1080p 144", resolution: 2, fps: 144, high: false },
                { name: "Max", detail: "1440p 360", resolution: 3, fps: 360, high: false },
            ]: ChoiceChip {
                text: preset.name; detail: preset.detail;
                checked: preset.resolution == root.pick-resolution && preset.fps == root.pick-fps
                    && preset.high == root.pick-high-quality;
                clicked => {
                    root.pick-resolution = preset.resolution; root.pick-fps = preset.fps;
                    root.pick-high-quality = preset.high;
                }
            }
        }
        ShareHeading { text: "RESOLUTION"; }
        HorizontalLayout {
            spacing: 4px;
            for choice in [{ text: "720p", index: 1 }, { text: "1080p", index: 2 }, { text: "1440p", index: 3 }, { text: "Source", index: 4 }]: ChoiceChip {
                text: choice.text; checked: choice.index == root.pick-resolution;
                clicked => { root.pick-resolution = choice.index; }
            }
        }
        ShareHeading { text: "FRAME RATE"; }
        VerticalLayout {
            // A preset's rate shows in the field, typed over or not.
            property <int> fps: root.pick-fps;
            changed fps => {
                if !fps-field.text.is-float() || round(fps-field.text.to-float()) != self.fps { fps-field.text = self.fps; }
            }
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                fps-field := TextField {
                    min-height: 32px; text-size: 14px; pad: 10px;
                    text: root.pick-fps; label: "Frames a second"; placeholder: "30";
                    edited(text) => {
                        if text.is-float() && text.to-float() >= 1 {
                            root.pick-fps = min(360, round(text.to-float()));
                        }
                    }
                }
                Text { text: "fps"; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 4px;
                for rate in [15, 30, 60, 120, 144, 240, 360]: ChoiceChip {
                    text: rate; checked: rate == root.pick-fps;
                    clicked => { root.pick-fps = rate; }
                }
            }
        }
        MenuItem {
            text: "Higher quality"; subtitle: "Sharper, at twice the CPU";
            checkbox: true; checked: root.pick-high-quality;
            clicked => { root.pick-high-quality = !root.pick-high-quality; }
        }
        MenuItem {
            text: "Share stream audio"; subtitle: "Other apps' sound goes with your screen";
            checkbox: true; checked: root.pick-audio;
            clicked => { root.pick-audio = !root.pick-audio; }
        }
    }
}

// Picking what to share, as Discord's dialog does: tabs for applications,
// screens and cameras, a picture of each, and a click on one goes live with
// the quality shown at the foot, which the gear changes.
export component ShareDialog inherits Rectangle {
    /// The screens, then the windows, then the cameras, to share; a pick
    /// counts the screens first.
    in property <[ShareScreen]> screens;
    in property <[ShareScreen]> windows;
    in property <[string]> cameras;
    /// The system's dialog picks a screen or window: one choice asks it,
    /// counted after the windows and before the cameras.
    in property <bool> dialog;
    /// Switching what's shared, at the stream's quality.
    in property <bool> switching;
    /// How far it's open, from 0 to 1, as PopupMotion gives it.
    in property <float> amount: 1;
    in-out property <int> tab;
    in-out property <int> pick-resolution;
    in-out property <int> pick-fps;
    in-out property <bool> pick-high-quality;
    in-out property <bool> pick-audio;
    callback go-live(int);
    callback close;
    property <int> dialog-index: root.screens.length + root.windows.length;
    property <int> first-camera: root.dialog-index + (root.dialog ? 1 : 0);
    property <bool> settings-open;
    property <string> preset-name:
        root.pick-resolution == 2 && root.pick-fps == 240 && !root.pick-high-quality ? "Games"
        : root.pick-resolution == 3 && root.pick-fps == 360 && !root.pick-high-quality ? "Max"
        : root.pick-resolution == 3 && root.pick-fps == 60 && root.pick-high-quality ? "Text"
        : root.pick-resolution == 1 && root.pick-fps == 30 && !root.pick-high-quality ? "Light"
        : "Custom";
    property <string> resolution-name: ["480p", "720p", "1080p", "1440p", "Source"][root.pick-resolution];
    background: #000000.with-alpha(0.7 * root.amount);
    forward-focus: keys;
    init => { keys.focus(); }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.settings-open { root.settings-open = false; } else { root.close(); }
                return accept;
            }
            return reject;
        }
        TouchArea { clicked => { root.close(); } }
        card := Rectangle {
            width: min(960px, root.width - 48px); height: min(745px, root.height - 48px);
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            opacity: Popup.opacity(root.amount);
            transform-scale: Popup.scale(root.amount);
            background: Theme.raised; border-radius: 8px; border-color: Theme.edge; border-width: 1px;
            drop-shadow-blur: 32px; drop-shadow-color: #00000099; drop-shadow-offset-y: 8px;
            accessible-role: groupbox; accessible-label: root.switching ? "Change stream" : "Share your screen";
            TouchArea { clicked => { root.settings-open = false; } }
            VerticalLayout {
                padding: 24px; padding-bottom: 20px; spacing: 20px;
                Rectangle {
                    height: 40px; border-radius: 8px; background: Theme.sunken;
                    HorizontalLayout {
                        padding: 4px; spacing: 4px;
                        ShareTab {
                            icon: @image-url("icons/app-window.svg"); text: "Applications"; checked: root.tab == 0;
                            clicked => { root.tab = 0; }
                        }
                        ShareTab {
                            icon: @image-url("icons/monitor.svg"); text: "Entire Screen"; checked: root.tab == 1;
                            clicked => { root.tab = 1; }
                        }
                        if root.cameras.length > 0: ShareTab {
                            icon: @image-url("icons/video.svg"); text: "Devices"; checked: root.tab == 2;
                            clicked => { root.tab = 2; }
                        }
                    }
                }
                grid := Flickable {
                    vertical-stretch: 1;
                    property <length> gap-x: 16px;
                    property <length> gap-y: 24px;
                    property <length> tile-width: (self.width - self.gap-x - 12px) / 2;
                    property <length> tile-height: self.tile-width * 9 / 16 + 34px;
                    property <int> count: root.tab == 0 ? root.windows.length
                        : root.tab == 1 ? root.screens.length + (root.dialog ? 1 : 0) : root.cameras.length;
                    content-height: max(self.height, ceil(self.count / 2) * (self.tile-height + self.gap-y));
                    if root.tab == 0: Rectangle {
                        for window[index] in root.windows: ShareTile {
                            x: mod(index, 2) * (grid.tile-width + grid.gap-x); y: floor(index / 2) * (grid.tile-height + grid.gap-y);
                            width: grid.tile-width;
                            text: window.title; picture: window.picture; icon: window.icon;
                            placeholder: @image-url("icons/app-window.svg");
                            clicked => { root.go-live(root.screens.length + index); }
                        }
                    }
                    if root.tab == 1: Rectangle {
                        for screen[index] in root.screens: ShareTile {
                            x: mod(index, 2) * (grid.tile-width + grid.gap-x); y: floor(index / 2) * (grid.tile-height + grid.gap-y);
                            width: grid.tile-width;
                            text: screen.title; picture: screen.picture;
                            placeholder: @image-url("icons/monitor.svg");
                            clicked => { root.go-live(index); }
                        }
                        if root.dialog: ShareTile {
                            x: mod(root.screens.length, 2) * (grid.tile-width + grid.gap-x);
                            y: floor(root.screens.length / 2) * (grid.tile-height + grid.gap-y);
                            width: grid.tile-width;
                            text: "Screen or window, picked in the system's dialog";
                            placeholder: @image-url("icons/monitor.svg");
                            clicked => { root.go-live(root.dialog-index); }
                        }
                    }
                    if root.tab == 2: Rectangle {
                        for camera[index] in root.cameras: ShareTile {
                            x: mod(index, 2) * (grid.tile-width + grid.gap-x); y: floor(index / 2) * (grid.tile-height + grid.gap-y);
                            width: grid.tile-width;
                            text: camera; placeholder: @image-url("icons/video.svg");
                            clicked => { root.go-live(root.first-camera + index); }
                        }
                    }
                    if grid.count == 0: Text {
                        y: 40px; width: grid.width; horizontal-alignment: center;
                        text: root.tab == 0 ? "No windows to share." : root.tab == 1 ? "No screens to share." : "No cameras.";
                        color: Theme.muted; font-size: 15px;
                    }
                }
                HorizontalLayout {
                    height: 44px; spacing: 12px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1;
                        Text { text: root.preset-name; color: Theme.text; font-size: 16px; font-weight: 700; }
                        Text {
                            text: root.resolution-name + " · " + root.pick-fps + "fps"
                                + (root.pick-high-quality ? " · Higher quality" : "") + (root.pick-audio ? "" : " · No sound");
                            color: Theme.muted; font-size: 13px;
                        }
                    }
                    Rectangle {
                        width: 40px; height: 40px; y: 2px; border-radius: 8px;
                        background: root.settings-open || gear-touch.has-hover ? Theme.active : Theme.hover;
                        accessible-role: button; accessible-label: "Stream settings";
                        accessible-action-default => { root.settings-open = !root.settings-open; }
                        Image { width: 22px; source: @image-url("icons/settings.svg"); image-fit: contain; colorize: Theme.text; }
                        gear-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.settings-open = !root.settings-open; }
                        }
                    }
                }
            }
            if root.settings-open: ShareSettings {
                width: min(340px, card.width - 48px);
                x: card.width - self.width - 24px; y: card.height - self.height - 76px;
                pick-resolution <=> root.pick-resolution; pick-fps <=> root.pick-fps;
                pick-high-quality <=> root.pick-high-quality; pick-audio <=> root.pick-audio;
            }
        }
    }
}

// A row of the menu while streaming.
component LiveRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> danger;
    in property <bool> chevron;
    in property <bool> checkbox;
    in property <bool> checked;
    /// Highlighted from outside, as a row whose submenu is open.
    in property <bool> held;
    out property <bool> hovered: row-touch.has-hover;
    callback clicked;
    height: 32px; border-radius: 4px;
    property <bool> lit: row-touch.has-hover || root.held;
    property <color> ink: root.lit ? (root.danger ? Theme.on-danger : Theme.text) : root.danger ? Theme.danger-text : Theme.secondary;
    background: root.lit ? (root.danger ? Theme.danger : Theme.overlay.with-alpha(0.09)) : transparent;
    accessible-role: button; accessible-label: root.text;
    accessible-checkable: root.checkbox; accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        if root.icon.width > 0: Image {
            width: 20px; source: root.icon; image-fit: contain; colorize: root.ink;
        }
        Text {
            text: root.text; color: root.ink; font-size: 14px; font-weight: 500;
            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
        if root.chevron: Image {
            width: 16px; source: @image-url("icons/chevron-right.svg"); image-fit: contain; colorize: root.ink;
        }
        if root.checkbox: Rectangle {
            width: 18px; height: 18px; y: 7px; border-radius: 4px;
            background: root.checked ? Theme.accent : transparent;
            border-width: root.checked ? 0px : 1.5px; border-color: root.ink;
            if root.checked: Image {
                width: 14px; source: @image-url("icons/check.svg"); image-fit: contain; colorize: #ffffff;
            }
        }
    }
    row-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A choice in the Stream Quality submenu, with its radio on the right.
component LiveRadio inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked;
    height: 32px; border-radius: 4px;
    background: radio-touch.has-hover ? Theme.overlay.with-alpha(0.09) : transparent;
    accessible-role: button; accessible-label: root.text; accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        Text {
            text: root.text; font-size: 14px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1;
            color: radio-touch.has-hover || root.checked ? Theme.text : Theme.secondary;
        }
        Rectangle {
            width: 18px; height: 18px; y: 7px; border-radius: 9px;
            border-width: 2px; border-color: root.checked ? Theme.accent : Theme.secondary;
            if root.checked: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
        }
    }
    radio-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// What the screen share button opens while streaming, as Discord's menu:
// stop, change what's shared, its quality, its sound, and reporting a
// problem. The quality's submenu opens beside it.
export component LiveMenu inherits Rectangle {
    in property <int> resolution;
    in property <int> fps;
    in property <bool> high-quality;
    in property <bool> audio;
    callback stop;
    callback change;
    callback requality(int, int, bool, bool);
    callback report;
    property <bool> quality-open;
    property <length> menu-width: 220px;
    out property <length> content-width: root.menu-width + 8px + 200px;
    // Tall enough for the quality submenu from the start: the popup's place
    // is set as it opens, so growing it later pushed the submenu past the
    // window's edge.
    out property <length> content-height: max(menu.height, quality.height);
    menu := Rectangle {
        x: 0px; y: root.content-height - self.height; width: root.menu-width; height: menu-rows.preferred-height;
        background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
        menu-rows := VerticalLayout {
            padding: 6px; spacing: 2px;
            LiveRow {
                icon: @image-url("icons/screen-share-off.svg"); text: "Stop Streaming"; danger: true;
                changed hovered => { if self.hovered { root.quality-open = false; } }
                clicked => { root.stop(); }
            }
            LiveRow {
                icon: @image-url("icons/screen-share.svg"); text: "Change Stream";
                changed hovered => { if self.hovered { root.quality-open = false; } }
                clicked => { root.change(); }
            }
            quality-row := LiveRow {
                text: "Stream Quality"; chevron: true; held: root.quality-open;
                changed hovered => { if self.hovered { root.quality-open = true; } }
                clicked => { root.quality-open = true; }
            }
            LiveRow {
                text: "Share Stream Audio"; checkbox: true; checked: root.audio;
                changed hovered => { if self.hovered { root.quality-open = false; } }
                clicked => { root.requality(root.resolution, root.fps, root.high-quality, !root.audio); }
            }
            Rectangle {
                height: 9px;
                Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
            }
            LiveRow {
                icon: @image-url("icons/triangle-alert.svg"); text: "Report Problem"; danger: true;
                changed hovered => { if self.hovered { root.quality-open = false; } }
                clicked => { root.report(); }
            }
        }
    }
    quality := Rectangle {
        x: root.menu-width + 8px; width: 200px; height: quality-rows.preferred-height;
        y: min(root.content-height - self.height, menu.y + quality-row.y + 6px - 6px);
        visible: root.quality-open;
        background: Theme.menu; border-color: Theme.menu-line; border-width: 1px; border-radius: 8px;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
        quality-rows := VerticalLayout {
            padding: 6px; spacing: 2px;
            HorizontalLayout { padding: 8px; padding-bottom: 4px; ShareHeading { text: "RESOLUTION"; } }
            for choice in [{ text: "720p", index: 1 }, { text: "1080p", index: 2 }, { text: "1440p", index: 3 }, { text: "Source", index: 4 }]: LiveRadio {
                text: choice.text; checked: choice.index == root.resolution;
                clicked => { root.requality(choice.index, root.fps, root.high-quality, root.audio); }
            }
            Rectangle {
                height: 9px;
                Rectangle { height: 1px; x: 4px; width: parent.width - 8px; background: Theme.menu-line; }
            }
            HorizontalLayout { padding: 8px; padding-bottom: 4px; ShareHeading { text: "FRAME RATE"; } }
            for rate in [15, 30, 60, 120, 144, 240, 360]: LiveRadio {
                text: rate + " fps"; checked: rate == root.fps;
                clicked => { root.requality(root.resolution, rate, root.high-quality, root.audio); }
            }
            if root.fps != 15 && root.fps != 30 && root.fps != 60 && root.fps != 120 && root.fps != 144 && root.fps != 240 && root.fps != 360: LiveRadio {
                text: root.fps + " fps"; checked: true;
            }
        }
    }
}

// Someone's volumes, from a right click on them in a call: their voice, and
// their stream's while they share their screen.
export component VolumeMenu inherits Rectangle {
    in property <string> volume-person;
    in property <string> volume-name;
    in property <bool> volume-live;
    /// Their stream is being watched: it can stop, and be muted, from here.
    in property <bool> volume-watched;
    in-out property <int> voice-volume;
    in-out property <int> stream-volume;
    out property <length> content-height: volume-content.preferred-height;
    /// A person, whether it's their stream, the volume, and whether it's
    /// the last of a drag.
    callback volume-changed(string, bool, int, bool);
    callback stop-watching;
    /// The stream's volume before muting it, which unmuting brings back.
    property <int> unmuted: 100;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox; accessible-label: root.volume-name + "'s volume";
    volume-content := VerticalLayout {
        padding: 12px; spacing: 12px;
        Text { text: root.volume-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
        VolumeSlider {
            label: "User volume"; maximum: 500;
            value <=> root.voice-volume;
            changed(volume) => { root.volume-changed(root.volume-person, false, volume, false); }
            committed(volume) => { root.volume-changed(root.volume-person, false, volume, true); }
        }
        if root.volume-watched: Rectangle {
            height: 32px; border-radius: 4px;
            background: stop-touch.has-hover ? Theme.overlay.with-alpha(0.09) : transparent;
            accessible-role: button; accessible-label: "Stop Watching";
            accessible-action-default => { root.stop-watching(); }
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 8px;
                Image { source: @image-url("icons/screen-share-off.svg"); width: 18px; image-fit: contain; colorize: Theme.text; }
                Text { text: "Stop Watching"; color: Theme.text; font-size: 14px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
            }
            stop-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.stop-watching(); } }
        }
        if root.volume-watched: Rectangle {
            height: 32px; border-radius: 4px;
            background: mute-touch.has-hover ? Theme.overlay.with-alpha(0.09) : transparent;
            accessible-role: checkbox; accessible-label: "Mute stream"; accessible-checked: root.stream-volume == 0;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 8px;
                Text { text: "Mute"; color: Theme.text; font-size: 14px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                Middle {
                    Rectangle {
                        width: 20px; height: 20px; border-radius: 4px;
                        background: root.stream-volume == 0 ? Theme.accent : transparent;
                        border-width: root.stream-volume == 0 ? 0px : 2px; border-color: Theme.secondary;
                        if root.stream-volume == 0: Image { source: @image-url("icons/check.svg"); width: 14px; colorize: Theme.on-accent; }
                    }
                }
            }
            mute-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    if root.stream-volume == 0 {
                        root.stream-volume = max(1, root.unmuted);
                    } else {
                        root.unmuted = root.stream-volume;
                        root.stream-volume = 0;
                    }
                    root.volume-changed(root.volume-person, true, root.stream-volume, true);
                }
            }
        }
        if root.volume-live: VolumeSlider {
            label: "Stream volume"; maximum: 500;
            value <=> root.stream-volume;
            changed(volume) => { root.volume-changed(root.volume-person, true, volume, false); }
            committed(volume) => { root.volume-changed(root.volume-person, true, volume, true); }
        }
    }
}

/// A soundboard sound: its id, name and emoji, if it has one.
export struct SoundCell { id: string, name: string, emoji: EmojiCell, favorite: bool }
/// A heading, or a row of up to three sounds, in the soundboard.
export struct SoundRow { heading: string, sounds: [SoundCell] }

// A sound to play. With extras, hovering offers hearing it first and
// starring it as a favourite; a favourite's star stays.
component SoundButton inherits Rectangle {
    in property <SoundCell> sound;
    in property <string> emoji-font;
    in property <bool> enabled;
    in property <bool> extras;
    in property <string> verb: "Play";
    callback clicked;
    callback preview;
    callback favorite(bool);
    property <bool> hovered: touch.has-hover || hear.hovered || star.hovered;
    height: 36px; border-radius: 8px;
    background: root.hovered && root.enabled ? Theme.button-default-hover : Theme.button-default;
    animate background { duration: Theme.quick; }
    accessible-role: button; accessible-label: root.verb + " " + root.sound.name; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 8px;
        opacity: root.enabled ? 1 : 0.5;
        if root.sound.emoji.glyph != "": EmojiFace {
            emoji: root.sound.emoji; font: root.emoji-font; side: 18px; width: 18px;
            animation-key: root.sound.emoji.key;
        }
        Text {
            text: root.sound.name; color: Theme.text; font-size: 14px; overflow: elide;
            vertical-alignment: center; horizontal-stretch: 1;
        }
    }
    // Still hovered while it can't be played, so a favourite can change.
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if root.enabled { root.clicked(); } }
    }
    hear := IconButton {
        x: parent.width - 2 * (self.width + 4px); y: (parent.height - self.height) / 2;
        size: 26px; glyph: 15px; radius: 6px; fill: Theme.button-default-hover;
        visible: root.extras && root.hovered;
        icon: @image-url("icons/volume-2.svg"); label: "Preview " + root.sound.name;
        clicked => { root.preview(); }
    }
    star := IconButton {
        x: parent.width - self.width - 4px; y: (parent.height - self.height) / 2;
        size: 26px; glyph: 15px; radius: 6px; fill: root.hovered ? Theme.button-default-hover : Theme.button-default;
        visible: root.extras && (root.hovered || root.sound.favorite);
        icon: root.sound.favorite ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg");
        tint: root.sound.favorite ? #f0b232 : Theme.secondary;
        label: root.sound.favorite ? "Remove from Favorites" : "Add to Favorites";
        clicked => { root.favorite(!root.sound.favorite); }
    }
}

// Discord's soundboard in a call: the favourites, the call's server's
// sounds, others' with Nitro, then Discord's own, three to a row. A click
// plays one for everyone in the call; while that can't be, the note says
// why. With extras, each offers hearing it first and starring it. Settings
// uses it to choose an entrance sound, with its own title and no extras.
export component Soundboard inherits Rectangle {
    in property <[SoundRow]> rows;
    in property <string> emoji-font;
    in property <string> title: "Soundboard";
    in property <bool> extras: true;
    /// What a click does to a sound, as its accessible label says.
    in property <string> verb: "Play";
    /// Why no sound can be played now, such as being deafened; empty when
    /// they can.
    in property <string> note;
    callback play(string);
    callback preview(string);
    callback favorite(string, bool);
    callback close;
    property <length> row-height: 42px;
    property <length> gap: 6px;
    width: 372px;
    height: min(440px, top.preferred-height + max(1, root.rows.length) * root.row-height + 10px);
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 10px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    clip: true;
    accessible-role: groupbox; accessible-label: root.title;
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
    }
    VerticalLayout {
        top := VerticalLayout {
            padding: 14px; padding-bottom: 4px; spacing: 4px;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; }
            if root.note != "": Text { text: root.note; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
            if root.rows.length == 0: Text { text: "Loading sounds..."; color: Theme.muted; font-size: 13px; }
        }
        ListView {
            vertical-stretch: 1;
            for row in root.rows: VerticalLayout {
                height: root.row-height; padding-left: 10px; padding-right: 10px;
                if row.heading != "": Text {
                    text: row.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
                    vertical-alignment: bottom; overflow: elide; height: root.row-height - 8px;
                }
                if row.heading == "": HorizontalLayout {
                    spacing: root.gap; padding-top: 3px; padding-bottom: 3px; alignment: start;
                    for sound in row.sounds: SoundButton {
                        width: (root.width - 20px - 2 * root.gap) / 3;
                        sound: sound; emoji-font: root.emoji-font; enabled: root.note == "";
                        extras: root.extras; verb: root.verb;
                        clicked => { root.play(sound.id); }
                        preview => { root.preview(sound.id); }
                        favorite(on) => { root.favorite(sound.id, on); }
                    }
                }
            }
        }
    }
}
