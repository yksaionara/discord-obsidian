import { ScrollView } from "scrollview.slint";
import { Theme, Popup, Middle } from "theme.slint";
import { ActionButton, IconButton, TextField, PictureStore } from "controls.slint";

/// An option of a server's onboarding question: its emoji, as text or a
/// picture's address, its title and description, and whether it's chosen.
export struct JoinOption { id: string, title: string, description: string, emoji: string, emoji-url: string, chosen: bool }

/// A field of a server's membership form: 0 its rules, 1 a short answer,
/// 2 a paragraph, 3 a choice of one, 4 one Discord Obsidian can't fill in.
export struct JoinField {
    kind: int,
    label: string, description: string, required: bool,
    rules: [string], agreed: bool,
    value: string, placeholder: string,
    choices: [string], chosen: int,
}

/// What a server just joined asks, as the window shows it: 0 it's on its way,
/// 1 one of its onboarding questions, 2 its membership form, 3 the form went
/// to its moderators.
export struct JoiningPrompt {
    kind: int,
    /// The server's name.
    name: string,
    /// The question's title, and "Choose one:" or "Choose all that apply.".
    title: string, hint: string,
    options: [JoinOption],
    /// How far through the questions, as "1 of 3".
    progress: string,
    can-back: bool,
    /// "Next", "Skip" or "Finish".
    next: string,
    description: string,
    fields: [JoinField],
    error: string,
    sending: bool,
}

/// Onboarding's questions and the membership form, as Discord's client asks
/// them of someone who just joined, over the window.
export component JoiningDialog inherits Rectangle {
    in property <JoiningPrompt> prompt;
    in property <float> motion: 1;
    callback pick(string);
    callback next(bool);
    callback agree(int, bool);
    callback text(int, string);
    callback choose(int, int);
    callback submit;
    callback close;
    background: rgba(0, 0, 0, 0.6 * root.motion);
    TouchArea { }
    Rectangle {
        opacity: Popup.opacity(root.motion); transform-scale: Popup.scale(root.motion);
        width: min(520px, root.width - 48px);
        height: min(root.height - 48px, content.preferred-height);
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.prompt.kind == 1 ? root.prompt.title : "Before you can talk in " + root.prompt.name;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
        }
        content := VerticalLayout {
            padding: 20px; spacing: 14px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.prompt.kind == 1 ? root.prompt.title
                        : root.prompt.kind == 3 ? "Your application is pending!"
                        : "Before you can talk in " + root.prompt.name + "...";
                    color: Theme.text; font-size: 20px; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1;
                }
                if root.prompt.progress != "": Middle {
                    Text { text: root.prompt.progress; color: Theme.muted; font-size: 13px; }
                }
                Middle {
                    IconButton {
                        icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px;
                        clicked => { root.close(); }
                    }
                }
            }
            if root.prompt.kind == 0: Text { text: "Loading..."; color: Theme.muted; font-size: 14px; }
            if root.prompt.kind == 3: Text {
                text: "Your application is pending review. The server's moderators will look at it, and you can talk once they approve it.";
                color: Theme.secondary; font-size: 15px; wrap: word-wrap;
            }
            // An onboarding question: its options as Discord's cards.
            if root.prompt.kind == 1: VerticalLayout {
                spacing: 8px;
                Text { text: root.prompt.hint; color: Theme.secondary; font-size: 14px; }
                ScrollView {
                    min-height: min(options.preferred-height, 360px);
                    max-height: 360px;
                    options := VerticalLayout {
                        spacing: 8px;
                        for option in root.prompt.options: Rectangle {
                            min-height: 48px; border-radius: 8px; border-width: 1px;
                            background: option.chosen ? Theme.accent-soft : touch.has-hover ? Theme.hover : Theme.sidebar;
                            border-color: option.chosen ? Theme.accent : Theme.line;
                            accessible-role: checkbox; accessible-checked: option.chosen;
                            accessible-label: option.title;
                            accessible-action-default => { root.pick(option.id); }
                            touch := TouchArea { mouse-cursor: pointer; enabled: !root.prompt.sending; clicked => { root.pick(option.id); } }
                            HorizontalLayout {
                                padding: 10px; spacing: 10px;
                                if option.emoji-url != "": Middle {
                                    Image {
                                        width: 24px; height: 24px; image-fit: contain;
                                        source: PictureStore.picture(option.emoji-url, PictureStore.revision);
                                        init => { if self.source.width == 0 { PictureStore.request(option.emoji-url); } }
                                    }
                                }
                                if option.emoji-url == "" && option.emoji != "": Middle {
                                    Text { text: option.emoji; font-size: 22px; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 2px; horizontal-stretch: 1;
                                    Text { text: option.title; color: Theme.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                                    if option.description != "": Text { text: option.description; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }
            // The membership form: its rules to agree to, and its questions.
            if root.prompt.kind == 2: ScrollView {
                min-height: min(fields.preferred-height, 420px);
                max-height: 420px;
                fields := VerticalLayout {
                    spacing: 16px;
                    if root.prompt.description != "": Text { text: root.prompt.description; color: Theme.secondary; font-size: 14px; wrap: word-wrap; }
                    for field[index] in root.prompt.fields: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 4px; alignment: start;
                            Text { text: field.label; color: Theme.text; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                            if field.required: Text { text: "*"; color: Theme.danger; font-size: 15px; font-weight: 700; }
                        }
                        if field.description != "": Text { text: field.description; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                        if field.kind == 0: Rectangle {
                            border-radius: 8px; background: Theme.sidebar;
                            VerticalLayout {
                                padding: 12px; spacing: 8px;
                                for rule[number] in field.rules: HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: (number + 1) + "."; color: Theme.muted; font-size: 14px; font-weight: 700; }
                                    Text { text: rule; color: Theme.text; font-size: 14px; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }
                        if field.kind == 0: Rectangle {
                            height: 28px;
                            accessible-role: checkbox; accessible-checked: field.agreed;
                            accessible-label: "I have read and agree to the rules";
                            accessible-action-default => { root.agree(index, !field.agreed); }
                            agree-touch := TouchArea { mouse-cursor: pointer; enabled: !root.prompt.sending; clicked => { root.agree(index, !field.agreed); } }
                            HorizontalLayout {
                                spacing: 10px; alignment: start;
                                Middle {
                                    Rectangle {
                                        width: 20px; height: 20px; border-radius: 4px; border-width: 2px;
                                        border-color: field.agreed ? Theme.accent : Theme.muted;
                                        background: field.agreed ? Theme.accent : transparent;
                                        if field.agreed: Image { source: @image-url("icons/check.svg"); width: 14px; height: 14px; colorize: Theme.on-accent; }
                                    }
                                }
                                Text { text: "I have read and agree to the rules"; color: Theme.text; font-size: 14px; vertical-alignment: center; }
                            }
                        }
                        if field.kind == 1 || field.kind == 2: TextField {
                            property <string> shown: field.value;
                            init => { self.text = self.shown; }
                            placeholder: field.placeholder; label: field.label; text-size: 14px;
                            min-height: field.kind == 2 ? 72px : 40px;
                            enabled: !root.prompt.sending;
                            edited(text) => { root.text(index, text); }
                        }
                        if field.kind == 3: VerticalLayout {
                            spacing: 6px;
                            for choice[at] in field.choices: Rectangle {
                                height: 36px; border-radius: 6px;
                                background: at == field.chosen ? Theme.accent-soft : choice-touch.has-hover ? Theme.hover : Theme.sidebar;
                                accessible-role: radio-button; accessible-checked: at == field.chosen; accessible-label: choice;
                                accessible-action-default => { root.choose(index, at); }
                                choice-touch := TouchArea { mouse-cursor: pointer; enabled: !root.prompt.sending; clicked => { root.choose(index, at); } }
                                HorizontalLayout {
                                    padding-left: 10px; spacing: 10px;
                                    Middle {
                                        Rectangle {
                                            width: 16px; height: 16px; border-radius: 8px; border-width: 2px;
                                            border-color: at == field.chosen ? Theme.accent : Theme.muted;
                                            if at == field.chosen: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                                        }
                                    }
                                    Text { text: choice; color: Theme.text; font-size: 14px; vertical-alignment: center; }
                                }
                            }
                        }
                        if field.kind == 4: Text {
                            text: "Discord Obsidian can't fill in this question yet.";
                            color: Theme.muted; font-size: 14px; wrap: word-wrap;
                        }
                    }
                }
            }
            if root.prompt.error != "": Text { text: root.prompt.error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                if root.prompt.kind == 1 && root.prompt.can-back: ActionButton {
                    text: "Back"; ghost: true; enabled: !root.prompt.sending;
                    clicked => { root.next(true); }
                }
                if root.prompt.kind == 1: ActionButton {
                    text: root.prompt.next; primary: true; enabled: !root.prompt.sending;
                    clicked => { root.next(false); }
                }
                if root.prompt.kind == 2: ActionButton {
                    text: root.prompt.sending ? "Submitting..." : "Submit"; primary: true; enabled: !root.prompt.sending;
                    clicked => { root.submit(); }
                }
                if root.prompt.kind == 3: ActionButton {
                    text: "Okay"; primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }
}
